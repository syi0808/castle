<div class="rougher-proof" data-proof="0" aria-hidden="true">
  <span class="word underline" data-rough-proof="underline">underline</span>
  <span class="word circle" data-rough-proof="circle">circle</span>
  <span class="word bracket" data-rough-proof="bracket">bracket</span>
</div>

<script>
  import { annotate, annotationGroup } from "@rougher-stuff/rough-notation";
  import type { RoughAnnotation } from "@rougher-stuff/rough-notation";
  import type { RoughAnnotationGroup } from "@rougher-stuff/rough-notation";

  const root = document.querySelector<HTMLElement>(".rougher-proof");
  let group: RoughAnnotationGroup | undefined;
  const annotations: RoughAnnotation[] = [];
  let played = false;

  const setup = async () => {
    if (!root) return;
    await document.fonts.ready;
    await new Promise<void>((resolve) => requestAnimationFrame(() => resolve()));
    const accent = getComputedStyle(document.documentElement).getPropertyValue("--color-accent").trim();
    const underline = root.querySelector<HTMLElement>("[data-rough-proof='underline']");
    const circle = root.querySelector<HTMLElement>("[data-rough-proof='circle']");
    const bracket = root.querySelector<HTMLElement>("[data-rough-proof='bracket']");
    if (!underline || !circle || !bracket) return;

    annotations.push(
      annotate(underline, { type: "underline", color: accent, strokeWidth: 2, iterations: 1, roughness: 1.25, seed: 43, padding: [0, 2, 8, 2], animationDuration: 420 }),
      annotate(circle, { type: "circle", color: accent, strokeWidth: 2, iterations: 1, roughness: 1.25, seed: 43, padding: 12, animationDuration: 520 }),
      annotate(bracket, { type: "bracket", brackets: ["right"], color: accent, strokeWidth: 2, iterations: 1, roughness: 1.25, seed: 43, padding: 12, animationDuration: 420 }),
    );
    group = annotationGroup(annotations);

    window.addEventListener("landing:proof", ((event: CustomEvent<{ index: number; reduced: boolean }>) => {
      if (event.detail.index !== 0 || !group) return;
      group.show({ duration: played || event.detail.reduced ? 0 : 1180 });
      played = true;
    }) as EventListener);
    window.addEventListener("pagehide", () => {
      annotations.forEach((annotation) => annotation.remove());
    }, { once: true });
  };

  void setup();
</script>

<style>
  .rougher-proof { display: grid; grid-template-columns: repeat(12, 1fr); grid-template-rows: repeat(3, 1fr); align-items: center; width: min(78vw, 66rem); height: min(52vh, 31rem); }
  .word { width: fit-content; color: var(--stage-ink); font-size: clamp(2.5rem, 5.6vw, 5.8rem); font-weight: 500; letter-spacing: -.055em; line-height: .9; }
  .underline { grid-column: 1 / 7; grid-row: 1; }
  .circle { grid-column: 7 / 13; grid-row: 2; justify-self: end; }
  .bracket { grid-column: 3 / 10; grid-row: 3; }

  @media (max-width: 700px) {
    .rougher-proof { width: calc(100vw - 2rem); height: 46vh; }
    .word { font-size: clamp(2.6rem, 13vw, 4.5rem); }
    .underline { grid-column: 1 / 11; }
    .circle { grid-column: 4 / 13; }
    .bracket { grid-column: 2 / 11; }
  }
</style>
