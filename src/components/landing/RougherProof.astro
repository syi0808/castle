<div class="rougher-artifact" data-rougher-artifact aria-hidden="true">
  <header><span>annotation.workbench</span><span>live render</span></header>
  <div class="rough-paper">
    <span class="paper-label">Rendered intent</span>
    <p>Documentation should feel <span data-rough-mark="underline">clear</span>, <span data-rough-mark="circle">direct</span>, and <span data-rough-mark="highlight">human</span>.</p>
    <div class="intent-map">
      <code>underline("clear")</code>
      <code>circle("direct")</code>
      <code>highlight("human")</code>
    </div>
  </div>
  <footer><span>semantic input</span><i></i><span>drawn gesture</span></footer>
</div>

<script>
  import { annotate, annotationGroup } from "@rougher-stuff/rough-notation";
  import type { RoughAnnotation, RoughAnnotationGroup } from "@rougher-stuff/rough-notation";

  const root = document.querySelector<HTMLElement>("[data-rougher-artifact]");
  const annotations: RoughAnnotation[] = [];
  let group: RoughAnnotationGroup | undefined;
  let played = false;

  const activate = (reduced: boolean) => {
    if (!group) return;
    group.show({ duration: played || reduced ? 0 : 1050 });
    root?.classList.add("rendered");
    played = true;
  };

  window.addEventListener("landing:scene", ((event: CustomEvent<{ name: string; reduced: boolean }>) => {
    if (event.detail.name === "rougher-stuff") activate(event.detail.reduced);
  }) as EventListener);

  const setup = async () => {
    if (!root) return;
    await document.fonts.ready;
    await new Promise<void>((resolve) => requestAnimationFrame(() => resolve()));
    const accent = getComputedStyle(document.documentElement).getPropertyValue("--color-accent").trim();
    const underline = root.querySelector<HTMLElement>("[data-rough-mark='underline']");
    const circle = root.querySelector<HTMLElement>("[data-rough-mark='circle']");
    const highlight = root.querySelector<HTMLElement>("[data-rough-mark='highlight']");
    if (!underline || !circle || !highlight) return;

    annotations.push(
      annotate(underline, { type: "underline", color: accent, strokeWidth: 2.2, iterations: 1, roughness: 1.3, seed: 43, padding: [0, 1, 7, 1], animationDuration: 320 }),
      annotate(circle, { type: "circle", color: accent, strokeWidth: 2.2, iterations: 1, roughness: 1.3, seed: 48, padding: 9, animationDuration: 380 }),
      annotate(highlight, { type: "highlight", color: "#d9b6aa", strokeWidth: 1.8, iterations: 1, roughness: 1.15, seed: 52, padding: 2, animationDuration: 350 }),
    );
    group = annotationGroup(annotations);
    const scene = root.closest<HTMLElement>("[data-project-scene]");
    if (scene?.getAttribute("aria-hidden") === "false") activate(window.matchMedia("(prefers-reduced-motion: reduce)").matches);
  };

  window.addEventListener("pagehide", () => annotations.forEach((annotation) => annotation.remove()), { once: true });
  void setup();
</script>

<style>
  .rougher-artifact { width: min(100%, 45rem); overflow: hidden; border: 1px solid #46443e; border-radius: 1rem; background: #22221e; box-shadow: 0 2rem 6rem rgba(0,0,0,.26); transform: rotate(.7deg); }
  header, footer { display: flex; align-items: center; justify-content: space-between; min-height: 2.6rem; padding: 0 1rem; color: #858178; font: .55rem var(--font-mono); text-transform: uppercase; }
  header { border-bottom: 1px solid #46443e; }
  header span:last-child::before { display: inline-block; width: 5px; height: 5px; margin-right: .5rem; border-radius: 50%; background: var(--color-accent); content: ""; }
  .rough-paper { position: relative; display: grid; min-height: clamp(19rem, 49vh, 29rem); padding: clamp(2.2rem, 5vw, 4.25rem); color: #1d1c1a; background: #efebe2; place-content: center; }
  .rough-paper::before { position: absolute; inset: 0; background-image: linear-gradient(rgba(29,28,26,.045) 1px, transparent 1px); background-size: 100% 2rem; content: ""; pointer-events: none; }
  .paper-label { position: absolute; top: 1rem; left: 1rem; color: #77736b; font: .52rem var(--font-mono); text-transform: uppercase; }
  .rough-paper p { position: relative; z-index: 1; max-width: 10em; margin: 0; font-size: clamp(2.5rem, 4.5vw, 4.5rem); font-weight: 500; letter-spacing: -.06em; line-height: 1.02; }
  .rough-paper p span { position: relative; white-space: nowrap; }
  .intent-map { position: relative; z-index: 1; display: flex; flex-wrap: wrap; gap: .4rem; margin-top: 2.8rem; }
  .intent-map code { padding: .32rem .5rem; border: 1px solid #cbc5b9; border-radius: .25rem; color: #706d66; font: .52rem var(--font-mono); opacity: 0; transform: translateY(.35rem); transition: opacity 220ms ease, transform 220ms ease; }
  .rendered .intent-map code { opacity: 1; transform: translateY(0); }
  .rendered .intent-map code:nth-child(2) { transition-delay: 90ms; }
  .rendered .intent-map code:nth-child(3) { transition-delay: 180ms; }
  footer { justify-content: flex-start; gap: .7rem; border-top: 1px solid #46443e; }
  footer i { width: 3rem; height: 1px; background: linear-gradient(90deg, var(--color-accent), #46443e); }

  @media (max-width: 700px) {
    .rougher-artifact { width: 100%; transform: none; }
    header, footer { min-height: 2rem; padding: 0 .7rem; font-size: .46rem; }
    .rough-paper { min-height: 24svh; padding: 2.2rem 1.5rem 1.5rem; }
    .rough-paper p { font-size: clamp(1.75rem, 8vw, 2.5rem); }
    .intent-map { margin-top: 1.4rem; }
    .intent-map code { font-size: .42rem; }
  }
</style>
