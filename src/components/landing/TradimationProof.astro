<div class="motion-artifact" data-motion-artifact aria-hidden="true">
  <header><span>state.transition</span><span>12 frames</span></header>
  <div class="motion-field" data-motion-field>
    <div class="state-caption before"><span>A</span> previous state</div>
    <div class="state-caption after"><span>B</span> next state</div>
    <div class="origin-line"></div>
    <div class="target-line" data-motion-target></div>
    <div class="motion-trail" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
    <div class="specimen-origin"><div class="specimen" data-motion-specimen><span>same</span><span>element</span></div></div>
    <div class="frame-strip" aria-hidden="true">{Array.from({ length: 12 }, (_, index) => <span>{String(index + 1).padStart(2, "0")}</span>)}</div>
  </div>
  <footer><code>DOM change</code><i></i><code>continuity</code></footer>
</div>

<script>
  import { createEffect } from "@tradimation/core";
  import type { EffectController } from "@tradimation/core";

  const root = document.querySelector<HTMLElement>("[data-motion-artifact]");
  const field = root?.querySelector<HTMLElement>("[data-motion-field]");
  const specimen = root?.querySelector<HTMLElement>("[data-motion-specimen]");
  const target = root?.querySelector<HTMLElement>("[data-motion-target]");
  let controller: EffectController | undefined;
  let distance = 0;
  let played = false;
  let running = false;

  const measure = () => {
    if (!field || !specimen || !target) return;
    const origin = field.clientWidth * .11;
    distance = Math.max(96, field.clientWidth * .67 - origin - specimen.offsetWidth / 2);
    target.style.left = `${origin + distance + specimen.offsetWidth / 2}px`;
    if (played) specimen.style.transform = `translateX(${distance}px)`;
  };

  const settle = () => {
    if (!specimen) return;
    specimen.style.transform = `translateX(${distance}px)`;
    root?.classList.add("settled");
    played = true;
  };

  const activate = async (reduced: boolean) => {
    if (!field || !specimen || running) return;
    await new Promise<void>((resolve) => requestAnimationFrame(() => resolve()));
    measure();
    root?.classList.add("playing");
    if (played || reduced) {
      settle();
      return;
    }
    running = true;
    try {
      controller = createEffect(specimen, "smear", { overlayRoot: field, distance, duration: 720, cleanup: "commit" });
      await controller.play();
    } catch {
      settle();
    } finally {
      settle();
      running = false;
    }
  };

  window.addEventListener("landing:scene", ((event: CustomEvent<{ name: string; reduced: boolean }>) => {
    if (event.detail.name === "trandimation") void activate(event.detail.reduced);
  }) as EventListener);
  window.addEventListener("resize", measure, { passive: true });
  window.addEventListener("pagehide", () => controller?.destroy(), { once: true });
</script>

<style>
  .motion-artifact { width: min(100%, 46rem); overflow: hidden; border: 1px solid #46443e; border-radius: 1rem; background: #20201d; box-shadow: 0 2rem 6rem rgba(0,0,0,.25); }
  header, footer { display: flex; align-items: center; justify-content: space-between; min-height: 2.6rem; padding: 0 1rem; color: #858178; font: .55rem var(--font-mono); text-transform: uppercase; }
  header { border-bottom: 1px solid #46443e; }
  .motion-field { position: relative; min-height: clamp(19rem, 49vh, 29rem); overflow: hidden; background-color: #1b1b18; background-image: linear-gradient(rgba(242,238,229,.055) 1px, transparent 1px), linear-gradient(90deg, rgba(242,238,229,.055) 1px, transparent 1px); background-size: 2rem 2rem; }
  .state-caption { position: absolute; top: 1.1rem; display: flex; gap: .45rem; align-items: center; color: #77746c; font: .5rem var(--font-mono); text-transform: uppercase; }
  .state-caption span { display: grid; width: 1.25rem; height: 1.25rem; border: 1px solid #48463f; border-radius: 50%; place-items: center; }
  .state-caption.before { left: 1rem; }
  .state-caption.after { right: 1rem; }
  .origin-line, .target-line { position: absolute; top: 16%; bottom: 18%; width: 1px; border-left: 1px dashed #4a4841; }
  .origin-line { left: 11%; }
  .target-line { left: 78%; }
  .target-line::before, .target-line::after { position: absolute; left: 50%; width: 7px; height: 7px; border: 1px solid var(--color-accent); border-radius: 50%; content: ""; transform: translate(-50%, -50%); }
  .target-line::before { top: 0; }
  .target-line::after { top: 100%; }
  .specimen-origin { position: absolute; top: 47%; left: 11%; transform: translateY(-50%); }
  .specimen { display: grid; grid-template-columns: auto auto; gap: .3rem; align-items: center; width: clamp(7.4rem, 13vw, 9.5rem); height: clamp(3.4rem, 6.5vw, 4.5rem); padding: 0 .9rem; border: 1px solid #f2eee5; border-radius: .55rem; color: #f2eee5; background: var(--color-accent); box-shadow: .4rem .4rem 0 #f2eee5; font-size: clamp(.75rem, 1.1vw, .95rem); font-weight: 500; letter-spacing: -.025em; transform-origin: center; }
  .specimen span:last-child { color: #e1bdb3; }
  .motion-trail { position: absolute; top: 47%; left: 11%; width: 67%; height: 4.5rem; transform: translateY(-50%); }
  .motion-trail::before { position: absolute; top: 50%; right: 0; left: 0; height: 1px; background: linear-gradient(90deg, var(--color-accent), #4a4841); content: ""; transform: scaleX(0); transform-origin: left; transition: transform 720ms ease-out; }
  .motion-trail i { position: absolute; top: 50%; width: 3px; height: 3px; border-radius: 50%; background: var(--color-accent); opacity: 0; transform: translate(-50%, -50%); transition: opacity 120ms ease; }
  .motion-trail i:nth-child(1) { left: 20%; }
  .motion-trail i:nth-child(2) { left: 40%; }
  .motion-trail i:nth-child(3) { left: 60%; }
  .motion-trail i:nth-child(4) { left: 80%; }
  .playing .motion-trail::before { transform: scaleX(1); }
  .playing .motion-trail i { opacity: .75; }
  .settled .target-line { border-left-color: var(--color-accent); }
  .frame-strip { position: absolute; right: 1rem; bottom: 1rem; left: 1rem; display: grid; grid-template-columns: repeat(12, 1fr); border-top: 1px solid #3d3b35; border-left: 1px solid #3d3b35; }
  .frame-strip span { display: grid; aspect-ratio: 1.6 / 1; border-right: 1px solid #3d3b35; border-bottom: 1px solid #3d3b35; color: #65625b; font: .43rem var(--font-mono); place-items: center; }
  footer { justify-content: center; gap: .7rem; border-top: 1px solid #46443e; }
  footer i { width: 3rem; height: 1px; background: linear-gradient(90deg, var(--color-accent), #46443e); }
  footer code { font: inherit; }

  @media (max-width: 700px) {
    .motion-artifact { width: 100%; }
    header, footer { min-height: 2rem; padding: 0 .7rem; font-size: .46rem; }
    .motion-field { min-height: 24svh; background-size: 1.25rem 1.25rem; }
    .specimen { width: 6.7rem; height: 3rem; padding: 0 .55rem; font-size: .66rem; box-shadow: .27rem .27rem 0 #f2eee5; }
    .frame-strip { right: .55rem; bottom: .55rem; left: .55rem; }
    .frame-strip span { font-size: .34rem; }
  }
</style>
