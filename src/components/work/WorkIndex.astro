---
import ProjectVisual from "./ProjectVisual.astro";
import { projects } from "../../data/projects";
const featured = projects.filter((project) => project.featured).sort((a, b) => a.order - b.order);
---

<section class="work-index" data-work-index>
  <div class="work-list">
    <div class="section-head"><h2 class="section-label">Selected Work</h2><a href={`${import.meta.env.BASE_URL}work`} class="all-link rough-link">All work ↗</a></div>
    <ol>
      {featured.map((project, index) => (
        <li data-chapter={project.visual}>
          <a class="project-row" data-project={project.visual} href={project.website ?? project.github} target="_blank" rel="noopener noreferrer">
            <span class="number">{String(index + 1).padStart(2, "0")}</span><strong>{project.name}</strong><span class="year">{project.year} ↗</span>
          </a>
          <div class="mobile-visual"><ProjectVisual name={project.visual!} /></div>
        </li>
      ))}
    </ol>
  </div>
  <div class="stage" aria-live="polite">{featured.map((project, index) => <ProjectVisual name={project.visual!} active={index === 0} />)}</div>
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-work-index]").forEach((index) => {
    const rows = [...index.querySelectorAll<HTMLElement>("[data-project]")];
    const chapters = [...index.querySelectorAll<HTMLElement>("[data-chapter]")];
    const visuals = [...index.querySelectorAll<HTMLElement>(".stage [data-visual]")];
    const activate = (name?: string) => {
      rows.forEach((row) => row.classList.toggle("active", row.dataset.project === name));
      visuals.forEach((visual) => {
        const isTarget = visual.dataset.visual === name;
        if (!isTarget && visual.classList.contains("active")) visual.classList.add("played");
        visual.classList.toggle("active", isTarget);
      });
    };
    rows.forEach((row) => {
      row.addEventListener("pointerenter", () => activate(row.dataset.project));
      row.addEventListener("focus", () => activate(row.dataset.project));
    });
    const observer = new IntersectionObserver((entries) => {
      const chapter = entries.find((entry) => entry.isIntersecting)?.target as HTMLElement | undefined;
      if (chapter) {
        activate(chapter.dataset.chapter);
        chapter.querySelector<HTMLElement>(".mobile-visual [data-visual]")?.classList.add("active");
      }
    }, { rootMargin: "-44% 0px -44% 0px" });
    chapters.forEach((chapter) => observer.observe(chapter));
    activate(rows[0]?.dataset.project);
  });
</script>

<style>
  .work-index { display: grid; grid-template-columns: minmax(22rem, .82fr) minmax(30rem, 1.18fr); align-items: start; border-top: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border); }
  .work-list { padding: 4rem clamp(2rem, 5vw, 5rem) 4rem 0; border-right: 1px solid var(--color-border); }
  .section-head { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 4rem; }
  .section-head h2 { margin: 0; }
  .all-link { color: var(--color-text-sub); font-size: .78rem; text-decoration: none; }
  ol { margin: 0; padding: 0; list-style: none; }
  li { display: grid; min-height: 45svh; border-top: 1px solid var(--color-border); align-items: center; }
  li:last-child { border-bottom: 1px solid var(--color-border); }
  .project-row { display: grid; grid-template-columns: 2.8rem 1fr auto; align-items: center; padding-right: .5rem; text-decoration: none; }
  .number, .year { color: var(--color-text-sub); font-family: var(--font-mono); font-size: .67rem; }
  .project-row strong { position: relative; width: fit-content; font-size: clamp(1.8rem, 3.3vw, 3.4rem); font-weight: 500; letter-spacing: -.055em; line-height: 1; }
  .project-row strong::after { position: absolute; right: 0; bottom: -.28em; left: 0; height: 6px; background: url("data:image/svg+xml,%3Csvg width='120' height='6' viewBox='0 0 120 6' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M1 4C18 0 31 6 48 3S76 5 91 3s18 2 28 0' fill='none' stroke='%23a04432' stroke-width='1.6'/%3E%3C/svg%3E") repeat-x / 120px 6px; content: ""; opacity: 0; transform: scaleX(0); transform-origin: left; }
  .project-row.active .number { color: var(--color-accent); }
  .project-row.active strong::after { opacity: 1; transform: scaleX(1); transition: opacity 100ms, transform 360ms var(--ease-out-back); }
  .stage { position: sticky; top: 13vh; overflow: hidden; height: 74vh; min-height: 34rem; }
  .mobile-visual { display: none; }

  @media (max-width: 850px) {
    .work-index { display: block; }
    .work-list { padding-right: 0; border-right: 0; }
    .stage { display: none; }
    li { display: block; min-height: 0; padding: 2rem 0 1rem; }
    .project-row { grid-template-columns: 2.5rem 1fr auto; min-height: 4rem; }
    .project-row strong { font-size: clamp(1.7rem, 8vw, 2.8rem); }
    .mobile-visual { display: block; min-height: 14rem; }
  }
</style>
