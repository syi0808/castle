---
interface Props { name: "rougher-stuff" | "trandimation" | "svgr2" | "zctf"; active?: boolean; }
const { name, active = false } = Astro.props;
---
<div class:list={["project-visual", `visual-${name}`, { active }]} data-visual={name} aria-hidden="true">
  {name === "rougher-stuff" && <svg viewBox="0 0 560 330"><text x="82" y="82" class="note">important</text><path class="arrow" d="M132 95c6 17-5 29-31 38m0 0 6-10m-6 10 12 1" /><text x="60" y="173" class="word">expressive</text><path class="scribble" d="M56 190c26-7 37 7 62 0s46 7 71-1 45 5 71-1" /><path class="connector" d="M264 184c74 3 92 47 157 47" /><circle cx="438" cy="231" r="27" /><path class="tick" d="m424 231 10 10 21-27" /></svg>}
  {name === "trandimation" && <svg viewBox="0 0 560 330"><rect class="ghost" x="70" y="138" width="48" height="48" /><text x="190" y="80" class="note">anticipation</text><path class="arrow" d="M231 91c-7 23-15 32-37 46m0 0 4-11m-4 11 12-1" /><rect class="block" x="180" y="138" width="48" height="48" /><path class="smear" d="M238 148h152m-152 12h180m-180 12h142" /><rect class="target" x="430" y="138" width="48" height="48" /></svg>}
  {name === "svgr2" && <svg viewBox="0 0 560 330"><text x="56" y="173" class="code">&lt;svg&gt;</text><path class="flow" d="M132 163h67m-9-8 10 8-10 8" /><rect x="215" y="132" width="92" height="62" /><text x="236" y="167" class="label">PARSE</text><path class="flow" d="M308 163h60m-9-8 10 8-10 8" /><path class="ast" d="M405 132v62m0-31h42m-19 0v-24m0 24v24" /><circle cx="405" cy="132" r="7" /><circle cx="447" cy="163" r="7" /><circle cx="428" cy="139" r="7" /><circle cx="428" cy="187" r="7" /><text x="373" y="225" class="code">&lt;Component /&gt;</text></svg>}
  {name === "zctf" && <svg viewBox="0 0 560 330"><text x="63" y="84" class="label">RUST</text><text x="444" y="84" class="label">JS</text><rect class="port" x="72" y="114" width="35" height="35" /><rect class="port" x="449" y="114" width="35" height="35" /><path class="fast" d="M112 131h330" /><text x="246" y="121" class="time">9.9ms</text><rect class="port muted" x="72" y="230" width="35" height="35" /><rect class="port muted" x="449" y="230" width="35" height="35" /><path class="slow" d="M112 247h330" /><text x="242" y="237" class="time">29.6ms / JSON</text></svg>}
</div>
<style>
  .project-visual { position: absolute; inset: 0; display: grid; place-items: center; opacity: 0; transform: translateY(8px); transition: opacity 180ms, transform 300ms var(--ease-out-back); pointer-events: none; } .project-visual.active { opacity: 1; transform: translateY(0); }
  svg { width: min(100%, 35rem); overflow: visible; } svg :global(path), svg :global(rect), svg :global(circle) { fill: none; stroke: var(--color-text); stroke-width: 1.5; vector-effect: non-scaling-stroke; }
  svg :global(text) { fill: var(--color-text); font-family: var(--font-mono); font-size: 15px; } svg :global(.note) { fill: var(--color-accent); font-size: 12px; } svg :global(.label), svg :global(.time) { fill: var(--color-text-sub); font-size: 10px; letter-spacing: .12em; } svg :global(.word) { font-family: var(--font-sans); font-size: 31px; letter-spacing: -.04em; }
  svg :global(.scribble), svg :global(.arrow), svg :global(.smear) { stroke: var(--color-accent); } svg :global(.connector), svg :global(.flow), svg :global(.slow) { stroke-dasharray: 5 5; } svg :global(.tick) { stroke: var(--color-accent); stroke-width: 2; }
  .visual-trandimation.active .block { animation: take 1.5s var(--ease-out-back) infinite; transform-origin: center; } .visual-trandimation .ghost { opacity: .3; } .visual-trandimation .target { stroke: var(--color-accent); stroke-dasharray: 4 3; } .visual-trandimation .smear { opacity: .45; }
  .visual-zctf .fast { stroke: var(--color-accent); stroke-width: 3; } .visual-zctf .slow { stroke: var(--color-text-sub); } .visual-zctf .muted { opacity: .45; }
  @keyframes take { 0%, 10% { transform: translateX(0) scale(1); } 22% { transform: translateX(-14px) scale(1.25, .75); } 52%, 75% { transform: translateX(250px) scale(.8, 1.2); } 100% { transform: translateX(250px); opacity: 0; } }
  @media (max-width: 760px) { .project-visual { position: relative; min-height: 15rem; } }
</style>
