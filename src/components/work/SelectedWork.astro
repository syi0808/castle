---
import { projects } from "../../data/projects";

const featured = projects.filter((project) => project.featured).sort((first, second) => first.order - second.order);
---

<section class="selected-work site-shell">
  <header>
    <h2>Projects</h2>
    <a href={`${import.meta.env.BASE_URL}work`}>All projects ↗</a>
  </header>
  <ol>
    {featured.map((project) => (
      <li>
        <a href={project.website ?? project.github} target="_blank" rel="noopener noreferrer">
          <span class="project">
            <strong data-project-title>{project.name}</strong>
            <span>{project.tagline}</span>
          </span>
          <span class="arrow">↗</span>
        </a>
      </li>
    ))}
  </ol>
</section>

<script>
  import { annotate } from "@rougher-stuff/rough-notation";
  import type { RoughAnnotation } from "@rougher-stuff/rough-notation";

  const section = document.querySelector<HTMLElement>(".selected-work");
  const annotations: RoughAnnotation[] = [];

  const setup = async () => {
    if (!section) return;
    await document.fonts.ready;
    const accent = getComputedStyle(document.documentElement).getPropertyValue("--color-accent").trim();
    section.querySelectorAll<HTMLElement>("[data-project-title]").forEach((title, index) => {
      const annotation = annotate(title, { type: "underline", color: accent, strokeWidth: 1.5, iterations: 1, roughness: 1.2, seed: 50 + index, padding: [0, 0, 4, 0], animationDuration: 260 });
      annotations.push(annotation);
      const link = title.closest<HTMLAnchorElement>("a");
      link?.addEventListener("pointerenter", () => annotation.show({ duration: 260 }));
      link?.addEventListener("pointerleave", () => annotation.hide());
      link?.addEventListener("focus", () => annotation.show({ duration: 260 }));
      link?.addEventListener("blur", () => annotation.hide());
    });
  };

  window.addEventListener("pagehide", () => annotations.forEach((annotation) => annotation.remove()), { once: true });
  void setup();
</script>

<style>
  .selected-work { padding-top: clamp(6rem, 12vw, 10rem); }
  header { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 2rem; }
  h2 { margin: 0; font-size: clamp(1.75rem, 3vw, 2.5rem); font-weight: 500; letter-spacing: -.045em; line-height: 1; }
  header a { color: var(--color-text-sub); font: .62rem var(--font-mono); text-decoration: none; }
  header a:hover, header a:focus-visible { color: var(--color-text); }
  ol { margin: 0; padding: 0; border-top: 1px solid var(--color-border); list-style: none; }
  li { border-bottom: 1px solid var(--color-border); }
  li > a { display: grid; grid-template-columns: minmax(0, 1fr) 1.5rem; align-items: center; min-height: clamp(5rem, 7vw, 6.5rem); text-decoration: none; }
  .project { display: flex; align-items: baseline; gap: 1rem; min-width: 0; }
  .project strong { font-size: clamp(1.05rem, 1.9vw, 1.45rem); font-weight: 500; letter-spacing: -.02em; line-height: 1.25; }
  .project > span { overflow: hidden; color: var(--color-text-sub); font-size: .78rem; text-overflow: ellipsis; white-space: nowrap; }
  .arrow { justify-self: end; color: var(--color-accent); opacity: 0; transform: translate(-.25rem, .25rem); transition: opacity 140ms, transform 180ms; }
  li a:hover .arrow, li a:focus-visible .arrow { opacity: 1; transform: translate(0, 0); }

  @media (max-width: 700px) {
    .selected-work { padding-top: 6rem; }
    li > a { grid-template-columns: minmax(0, 1fr) 1rem; min-height: 5.75rem; }
    .project { display: grid; gap: .25rem; padding-right: 1rem; }
    .project strong { font-size: 1.05rem; }
    .project > span { font-size: .7rem; }
  }
</style>
