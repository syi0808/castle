---
import ProjectVisual from "./ProjectVisual.astro";
import { categorySymbols, projects } from "../../data/projects";

const featured = projects.filter((project) => project.featured && project.visual).sort((first, second) => first.order - second.order);
---

<section class="selected-work site-shell" data-selected-work>
  <header class="section-head">
    <div><span>01</span><h2>Selected work</h2></div>
    <a href={`${import.meta.env.BASE_URL}work`}>All work ↗</a>
  </header>
  <div class="work-catalog">
    <ol class="work-list">
      {featured.map((project, index) => (
        <li class="work-row">
          <a href={project.website ?? project.github} data-project-row={project.visual} target="_blank" rel="noopener noreferrer">
            <span class="project-number">{String(index + 1).padStart(2, "0")}</span>
            <span class="project-copy"><strong data-project-title>{project.name}</strong><span>{project.tagline}</span></span>
            <span class="project-kind" aria-label={project.category}>{categorySymbols[project.category]}</span>
            <time>{project.year}</time><span class="external">↗</span>
          </a>
          <div class="mobile-visual"><ProjectVisual name={project.visual!} /></div>
        </li>
      ))}
    </ol>
    <aside class="work-stage" aria-live="polite">
      {featured.map((project, index) => <ProjectVisual name={project.visual!} active={index === 0} />)}
      <footer><span>Input → Transform → Output</span><span data-stage-name>{featured[0]?.name}</span></footer>
    </aside>
  </div>
</section>

<script>
  import { annotate } from "@rougher-stuff/rough-notation";
  import type { RoughAnnotation } from "@rougher-stuff/rough-notation";

  const section = document.querySelector<HTMLElement>("[data-selected-work]");
  const rows = [...(section?.querySelectorAll<HTMLAnchorElement>("[data-project-row]") ?? [])];
  const visuals = [...(section?.querySelectorAll<HTMLElement>(".work-stage [data-visual]") ?? [])];
  const mobileVisuals = [...(section?.querySelectorAll<HTMLElement>(".mobile-visual [data-visual]") ?? [])];
  const stageName = section?.querySelector<HTMLElement>("[data-stage-name]");
  const annotations = new Map<HTMLElement, RoughAnnotation>();
  let scrollName = rows[0]?.dataset.projectRow;
  let pointerName: string | undefined;

  const activate = (name?: string) => {
    visuals.forEach((visual) => visual.classList.toggle("active", visual.dataset.visual === name));
    rows.forEach((row) => {
      const active = row.dataset.projectRow === name;
      row.classList.toggle("active", active);
      const title = row.querySelector<HTMLElement>("[data-project-title]");
      if (!title) return;
      const annotation = annotations.get(title);
      if (active) annotation?.show({ duration: 260 });
      else annotation?.hide();
    });
    if (stageName) stageName.textContent = name ?? "Visual index";
  };

  rows.forEach((row) => {
    const name = row.dataset.projectRow;
    row.addEventListener("pointerenter", () => { pointerName = name; activate(name); });
    row.addEventListener("pointerleave", () => { if (document.activeElement === row) return; pointerName = undefined; activate(scrollName); });
    row.addEventListener("focus", () => { pointerName = name; activate(name); });
    row.addEventListener("blur", () => { pointerName = undefined; activate(scrollName); });
  });

  const setup = async () => {
    if (!section) return;
    await document.fonts.ready;
    const accent = getComputedStyle(document.documentElement).getPropertyValue("--color-accent").trim();
    section.querySelectorAll<HTMLElement>("[data-project-title]").forEach((title, index) => {
      annotations.set(title, annotate(title, { type: "underline", color: accent, strokeWidth: 1.7, iterations: 1, roughness: 1.25, seed: 50 + index, padding: [0, 0, 5, 0], animationDuration: 280 }));
    });
    activate(scrollName);

    const rowObserver = new IntersectionObserver((entries) => {
      const entry = entries.find((candidate) => candidate.isIntersecting);
      if (!entry) return;
      scrollName = (entry.target as HTMLElement).dataset.projectRow;
      if (!pointerName) activate(scrollName);
    }, { rootMargin: "-43% 0px -43% 0px" });
    rows.forEach((row) => rowObserver.observe(row));

    const mobileObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => { if (entry.isIntersecting) (entry.target as HTMLElement).classList.add("active"); });
    }, { rootMargin: "-20% 0px -20% 0px" });
    mobileVisuals.forEach((visual) => mobileObserver.observe(visual));

    window.addEventListener("pagehide", () => {
      rowObserver.disconnect();
      mobileObserver.disconnect();
      annotations.forEach((annotation) => annotation.remove());
    }, { once: true });
  };

  activate(scrollName);
  void setup();
</script>

<style>
  .selected-work { padding-top: clamp(3.5rem, 7vw, 6rem); }
  .section-head { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 2rem; }
  .section-head > div { display: flex; gap: 1rem; align-items: baseline; }
  .section-head span, .section-head a { color: var(--color-text-sub); font: .62rem var(--font-mono); text-transform: uppercase; }
  .section-head > div > span { color: var(--color-accent); }
  .section-head h2 { margin: 0; font-size: clamp(1.75rem, 3vw, 2.5rem); font-weight: 500; letter-spacing: -.045em; line-height: 1; }
  .section-head a { text-decoration: none; }
  .section-head a:hover, .section-head a:focus-visible { color: var(--color-text); }
  .work-catalog { display: grid; grid-template-columns: minmax(27rem, .88fr) minmax(32rem, 1.12fr); align-items: start; border-top: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border); }
  .work-list { margin: 0; padding: 0; border-right: 1px solid var(--color-border); list-style: none; }
  .work-row { border-bottom: 1px solid var(--color-border); }
  .work-row:last-child { border-bottom: 0; }
  .work-row > a { display: grid; grid-template-columns: 2.75rem minmax(0, 1fr) 2rem 3.5rem 1.25rem; align-items: center; min-height: clamp(11rem, 47svh, 21rem); padding-right: clamp(1rem, 2vw, 2rem); text-decoration: none; transition: background-color 160ms; }
  .project-number, time { color: var(--color-text-sub); font: .61rem var(--font-mono); }
  .project-copy { display: grid; gap: .65rem; }
  .project-copy strong { width: fit-content; font-size: clamp(1.8rem, 3.2vw, 3.2rem); font-weight: 500; letter-spacing: -.055em; line-height: .95; }
  .project-copy > span { color: var(--color-text-sub); font-size: .7rem; line-height: 1.2; }
  .project-kind { color: var(--color-text-sub); font-size: 1rem; }
  .external { color: var(--color-accent); opacity: 0; transform: translate(-.25rem, .25rem); transition: opacity 140ms, transform 180ms; }
  .work-row a.active { background: color-mix(in srgb, var(--color-surface) 42%, transparent); }
  .work-row a.active .project-number { color: var(--color-accent); }
  .work-row a:hover .external, .work-row a:focus-visible .external { opacity: 1; transform: translate(0, 0); }
  .mobile-visual { display: none; }
  .work-stage { position: sticky; top: 5.5rem; height: min(70svh, 34rem); overflow: hidden; }
  .work-stage > footer { position: absolute; right: 1.25rem; bottom: .8rem; left: 1.25rem; display: flex; justify-content: space-between; color: var(--color-text-sub); font: .5rem var(--font-mono); text-transform: uppercase; }
  .work-stage > footer span:last-child { color: var(--color-accent); }

  @media (max-width: 850px) {
    .selected-work { padding-top: 4.5rem; }
    .work-catalog { display: block; }
    .work-list { border-right: 0; }
    .work-row > a { grid-template-columns: 2.4rem minmax(0, 1fr) 1.5rem 1.1rem; min-height: 6.5rem; padding-right: 0; }
    .project-copy strong { font-size: clamp(1.8rem, 8vw, 2.8rem); }
    .project-copy > span { font-size: .65rem; }
    time { display: none; }
    .mobile-visual { display: block; min-height: 18rem; border-top: 1px solid var(--color-border); }
    .work-stage { display: none; }
  }
</style>
