---
import type { BlogPost } from "../../lib/posts";
interface Props { posts: BlogPost[]; heading?: string; }
const { posts, heading = "Writing" } = Astro.props;
const formatDate = (date: Date) => `${String(date.getMonth() + 1).padStart(2, "0")}.${String(date.getDate()).padStart(2, "0")}`;
---
<section class="writing-index" data-writing-index>
  <div class="heading"><h2 class="section-label">{heading}</h2><a href={`${import.meta.env.BASE_URL}archive`} class="rough-link">Archive ↗</a></div>
  <ol>{posts.map((post) => <li><a href={`${import.meta.env.BASE_URL}${post.id}`}><time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time><span class="title rough-link">{post.data.title}</span><span class="arrow">→</span></a></li>)}</ol>
</section>
<script>
  document.querySelectorAll<HTMLElement>("[data-writing-index]").forEach((section) => {
    const observer = new IntersectionObserver(([entry]) => {
      if (!entry.isIntersecting) return;
      section.classList.add("visible");
      observer.disconnect();
    }, { rootMargin: "0px 0px -20%" });
    observer.observe(section);
  });
</script>
<style>
  .heading { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 2rem; } h2 { margin: 0; } .heading > a { color: var(--color-text-sub); font-size: .78rem; text-decoration: none; } ol { position: relative; margin: 0; padding: 0; border-top: 1px solid var(--color-border); list-style: none; } ol::before { position: absolute; z-index: 1; top: 0; bottom: 0; left: 3.25rem; width: 4px; background: url("data:image/svg+xml,%3Csvg width='4' height='100' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M2 0c-3 19 3 33 0 52s3 31 0 48' fill='none' stroke='%23a04432' stroke-width='1.2' stroke-dasharray='3 6'/%3E%3C/svg%3E") repeat-y; content: ""; opacity: .7; transform: scaleY(0); transform-origin: top; } .visible ol::before { transform: scaleY(1); transition: transform 650ms ease-out; } li { position: relative; z-index: 2; border-bottom: 1px solid var(--color-border); } li > a { display: grid; grid-template-columns: 4.2rem 1fr 1.2rem; align-items: center; min-height: 5rem; text-decoration: none; } time { color: var(--color-text-sub); font-family: var(--font-mono); font-size: .65rem; } .title { width: fit-content; font-size: clamp(1rem, 1.6vw, 1.2rem); font-weight: 500; line-height: 1.3; letter-spacing: -.015em; } .arrow { color: var(--color-accent); opacity: 0; transform: translateX(-8px); transition: opacity 150ms, transform 200ms; } li a:hover .arrow, li a:focus-visible .arrow { opacity: 1; transform: translateX(0); }
  @media (max-width: 650px) { ol::before { left: 2.85rem; } li > a { grid-template-columns: 3.6rem 1fr auto; min-height: 4.75rem; } }
  @media (prefers-reduced-motion: reduce) { ol::before { transform: scaleY(1); } }
</style>
