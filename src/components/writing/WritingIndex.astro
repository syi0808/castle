---
import type { BlogPost } from "../../lib/posts";
interface Props { posts: BlogPost[]; }
const { posts } = Astro.props;
const formatDate = (date: Date) => `${String(date.getMonth() + 1).padStart(2, "0")}.${String(date.getDate()).padStart(2, "0")}`;
---

<section class="writing-index site-shell" data-writing-index>
  <header><h2>Writing</h2><a href={`${import.meta.env.BASE_URL}archive`}>Archive ↗</a></header>
  <ol>
    {posts.map((post) => (
      <li><a href={`${import.meta.env.BASE_URL}${post.id}`}><time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time><span class="title" data-writing-title>{post.data.title}</span><span class="tag">{post.data.tags[0] ?? "note"}</span><span class="arrow">→</span></a></li>
    ))}
  </ol>
</section>

<script>
  import { annotate } from "@rougher-stuff/rough-notation";
  import type { RoughAnnotation } from "@rougher-stuff/rough-notation";
  const section = document.querySelector<HTMLElement>("[data-writing-index]");
  const annotations: RoughAnnotation[] = [];
  const setup = async () => {
    if (!section) return;
    await document.fonts.ready;
    const accent = getComputedStyle(document.documentElement).getPropertyValue("--color-accent").trim();
    section.querySelectorAll<HTMLElement>("[data-writing-title]").forEach((title, index) => {
      const annotation = annotate(title, { type: "underline", color: accent, strokeWidth: 1.5, iterations: 1, roughness: 1.2, seed: 70 + index, padding: [0, 0, 4, 0], animationDuration: 260 });
      annotations.push(annotation);
      const link = title.closest<HTMLAnchorElement>("a");
      link?.addEventListener("pointerenter", () => annotation.show({ duration: 260 }));
      link?.addEventListener("pointerleave", () => annotation.hide());
      link?.addEventListener("focus", () => annotation.show({ duration: 260 }));
      link?.addEventListener("blur", () => annotation.hide());
    });
  };
  window.addEventListener("pagehide", () => annotations.forEach((annotation) => annotation.remove()), { once: true });
  void setup();
</script>

<style>
  .writing-index { padding: clamp(6rem, 12vw, 11rem) 0 3rem; }
  header { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 2rem; }
  header > a { color: var(--color-text-sub); font: .62rem var(--font-mono); }
  h2 { margin: 0; font-size: clamp(1.75rem, 3vw, 2.5rem); font-weight: 500; letter-spacing: -.045em; line-height: 1; }
  header > a { text-decoration: none; }
  header > a:hover, header > a:focus-visible { color: var(--color-text); }
  ol { margin: 0; padding: 0; border-top: 1px solid var(--color-border); list-style: none; }
  li { border-bottom: 1px solid var(--color-border); }
  li > a { display: grid; grid-template-columns: 4.5rem minmax(0, 1fr) 8rem 1.5rem; align-items: center; min-height: clamp(5rem, 7vw, 6.5rem); text-decoration: none; }
  time, .tag { color: var(--color-text-sub); font: .61rem var(--font-mono); }
  .title { width: fit-content; font-size: clamp(1.05rem, 1.9vw, 1.45rem); font-weight: 500; letter-spacing: -.02em; line-height: 1.25; }
  .arrow { justify-self: end; color: var(--color-accent); opacity: 0; transform: translateX(-.35rem); transition: opacity 140ms, transform 180ms; }
  li a:hover .arrow, li a:focus-visible .arrow { opacity: 1; transform: translateX(0); }
  @media (max-width: 700px) { .writing-index { padding-top: 6rem; } li > a { grid-template-columns: 3.5rem minmax(0, 1fr) 1rem; min-height: 5.75rem; } .tag { display: none; } .title { padding-right: .75rem; font-size: 1.02rem; } }
</style>
