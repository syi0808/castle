---
import type { BlogPost } from "../../lib/posts";
interface Props { posts: BlogPost[]; heading?: string; }
const { posts, heading = "Writing" } = Astro.props;
const formatDate = (date: Date) => `${String(date.getMonth() + 1).padStart(2, "0")}.${String(date.getDate()).padStart(2, "0")}`;
---
<section class="writing-index">
  <div class="heading"><h2 class="section-label">{heading}</h2><a href={`${import.meta.env.BASE_URL}archive`} class="rough-link">Archive ↗</a></div>
  <ol>{posts.map((post) => <li><a href={`${import.meta.env.BASE_URL}${post.id}`}><time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time><span class="title rough-link">{post.data.title}</span><span class="arrow">→</span></a></li>)}</ol>
</section>
<style>
  .heading { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 2rem; } h2 { margin: 0; } .heading > a { color: var(--color-text-sub); font-size: .78rem; text-decoration: none; } ol { margin: 0; padding: 0; border-top: 1px solid var(--color-border); list-style: none; } li { border-bottom: 1px solid var(--color-border); } li > a { display: grid; grid-template-columns: 4.2rem 1fr 1.2rem; align-items: center; min-height: 5rem; text-decoration: none; } time { color: var(--color-text-sub); font-family: var(--font-mono); font-size: .65rem; } .title { width: fit-content; font-size: clamp(1rem, 1.6vw, 1.2rem); font-weight: 500; line-height: 1.3; letter-spacing: -.015em; } .arrow { color: var(--color-accent); opacity: 0; transform: translateX(-8px); transition: opacity 150ms, transform 200ms; } li a:hover .arrow, li a:focus-visible .arrow { opacity: 1; transform: translateX(0); }
  @media (max-width: 650px) { li > a { grid-template-columns: 3.6rem 1fr auto; min-height: 4.75rem; } }
</style>
