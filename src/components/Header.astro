---
import ThemeToggle from "./ThemeToggle.astro";
const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;
const isHome = currentPath === base;
const navItems = [{ label: "Projects", href: `${base}work` }, { label: "Writing", href: `${base}archive` }];
---
<header class="site-header"><nav class="site-shell nav" aria-label="Main navigation">
  <div class="nav-links">
    {!isHome && <a href={base} class="nav-link" data-nav-link>Home</a>}
    {navItems.map((item) => <a href={item.href} class="nav-link" data-nav-link aria-current={currentPath.startsWith(item.href) ? "page" : undefined}>{item.label}</a>)}
    <a href="https://github.com/syi0808" class="nav-link gh" data-nav-link target="_blank" rel="noopener noreferrer" aria-label="GitHub, opens in a new window">GitHub ↗</a><ThemeToggle />
  </div>
</nav></header>

<script>
  import { annotate } from "@rougher-stuff/rough-notation";
  import type { RoughAnnotation } from "@rougher-stuff/rough-notation";

  const header = document.querySelector<HTMLElement>(".site-header");
  const annotations: RoughAnnotation[] = [];

  const setup = async () => {
    if (!header) return;
    await document.fonts.ready;
    const accent = getComputedStyle(document.documentElement).getPropertyValue("--color-accent").trim();
    header.querySelectorAll<HTMLElement>("[data-nav-link]").forEach((link, index) => {
      const annotation = annotate(link, { type: "underline", color: accent, strokeWidth: 1.5, iterations: 1, roughness: 1.2, seed: 90 + index, padding: [0, 0, 4, 0], animationDuration: 260 });
      annotations.push(annotation);
      link.addEventListener("pointerenter", () => annotation.show({ duration: 260 }));
      link.addEventListener("pointerleave", () => annotation.hide());
      link.addEventListener("focus", () => annotation.show({ duration: 260 }));
      link.addEventListener("blur", () => annotation.hide());
    });
  };

  window.addEventListener("pagehide", () => annotations.forEach((annotation) => annotation.remove()), { once: true });
  void setup();
</script>

<style>
  .site-header { position: relative; z-index: 40; } .nav { display: flex; align-items: center; justify-content: flex-end; height: 5rem; }
  .nav-links { display: flex; align-items: center; gap: clamp(1.1rem, 2.5vw, 2.4rem); font-size: .82rem; }
  .nav-link { text-decoration: none; }
  .nav-link[aria-current="page"] { color: var(--color-accent); }
  @media (max-width: 520px) { .nav { height: 4.25rem; } .gh { display: none; } .nav-links { gap: 1.15rem; } }
</style>
