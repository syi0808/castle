---
import IdentityMachine from "./IdentityMachine.astro";
---

<section class="identity-hero site-shell" data-identity-hero>
  <div class="identity-copy">
    <span class="eyebrow">Software engineer</span>
    <h1>Yein Sung</h1>
    <p>I make tools, interfaces,<br />and <span data-identity-mark>things I wish existed.</span></p>
  </div>
  <div class="identity-visual">
    <IdentityMachine />
    <div class="identity-meta" aria-label="Location and focus">
      <span>Seoul · KR</span><span>Open source</span><span>2026</span>
    </div>
  </div>
</section>

<script>
  import { annotate } from "@rougher-stuff/rough-notation";
  import type { RoughAnnotation } from "@rougher-stuff/rough-notation";

  const hero = document.querySelector<HTMLElement>("[data-identity-hero]");
  const mark = hero?.querySelector<HTMLElement>("[data-identity-mark]");
  let annotation: RoughAnnotation | undefined;

  const setup = async () => {
    if (!mark) return;
    await document.fonts.ready;
    const accent = getComputedStyle(document.documentElement).getPropertyValue("--color-accent").trim();
    annotation = annotate(mark, { type: "underline", color: accent, strokeWidth: 1.8, iterations: 1, roughness: 1.2, seed: 43, padding: [0, 0, 5, 0], animationDuration: 280 });
    annotation.show({ duration: 520 });
    mark.addEventListener("pointerenter", () => annotation?.show({ duration: 280 }));
    mark.addEventListener("pointerleave", () => annotation?.hide());
  };

  window.addEventListener("pagehide", () => annotation?.remove(), { once: true });
  void setup();
</script>

<style>
  .identity-hero { display: grid; grid-template-columns: minmax(28rem, 1.12fr) minmax(23rem, .88fr); min-height: clamp(32rem, 70svh, 44rem); border-top: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border); }
  .identity-copy { display: flex; flex-direction: column; justify-content: center; padding: clamp(3.5rem, 7vw, 6rem) clamp(2rem, 5vw, 5rem) clamp(3.5rem, 7vw, 6rem) 0; }
  .eyebrow { margin-bottom: clamp(2rem, 4vh, 3rem); color: var(--color-text-sub); font: .63rem var(--font-mono); letter-spacing: .05em; text-transform: uppercase; }
  h1 { margin: 0; font-size: clamp(5rem, 8.5vw, 8rem); font-weight: 500; letter-spacing: -.085em; line-height: .78; }
  p { margin: clamp(2.4rem, 5vh, 3.5rem) 0 0; font-size: clamp(1.7rem, 3vw, 2.75rem); font-weight: 500; letter-spacing: -.045em; line-height: 1.08; }
  [data-identity-mark] { position: relative; white-space: nowrap; }
  .identity-visual { display: grid; grid-template-rows: 1fr auto; min-width: 0; padding: clamp(2rem, 4vw, 4rem) 0 clamp(1.5rem, 3vw, 2.5rem) clamp(2rem, 5vw, 5rem); border-left: 1px solid var(--color-border); }
  .identity-meta { display: flex; justify-content: space-between; padding-top: 1.25rem; border-top: 1px solid var(--color-border); color: var(--color-text-sub); font: .57rem var(--font-mono); letter-spacing: .03em; text-transform: uppercase; }

  @media (max-width: 780px) {
    .identity-hero { grid-template-columns: 1fr; min-height: 0; }
    .identity-copy { padding: 3.5rem 0 3rem; }
    .eyebrow { margin-bottom: 2rem; }
    h1 { font-size: clamp(4.5rem, 20vw, 6.5rem); }
    p { margin-top: 2.5rem; font-size: clamp(1.55rem, 7vw, 2.2rem); }
    .identity-visual { min-height: 17rem; padding: 1.25rem 0; border-top: 1px solid var(--color-border); border-left: 0; }
  }
</style>
