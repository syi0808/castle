<button class="machine" type="button" data-identity-machine data-beat="0" aria-label="Play the transformation study">
  <svg viewBox="0 0 600 360" role="presentation">
    <path class="axis" d="M72 180H528" />
    <circle class="endpoint origin" cx="84" cy="180" r="20" />
    <rect class="endpoint result" x="488" y="160" width="40" height="40" />
    <path class="input-path" d="M105 180H260" />
    <path class="output-path" d="M340 180H487" />
    <circle class="signal" cx="114" cy="180" r="6" />
    <g class="between">
      <rect class="before-shape" x="278" y="157" width="46" height="46" />
      <path class="branch" d="M301 157v-50m0 96v50m0-73h52m-52 0h-46" />
      <circle class="branch-node top" cx="301" cy="98" r="9" />
      <path class="branch-node bottom" d="m301 242 11 11-11 11-11-11Z" />
    </g>
    <path class="smear smear-a" d="M242 164h96" />
    <path class="smear smear-b" d="M231 180h124" />
    <path class="smear smear-c" d="M249 196h91" />
    <path class="trace" d="M461 223c18-8 31 8 48 0s28 7 45-2" />
  </svg>
  <span>play →</span>
</button>

<script>
  const machine = document.querySelector<HTMLButtonElement>("[data-identity-machine]");
  let timers: number[] = [];
  let entered = false;
  const clear = () => { timers.forEach((timer) => window.clearTimeout(timer)); timers = []; };
  const play = () => {
    if (!machine) return;
    clear();
    machine.dataset.beat = "0";
    requestAnimationFrame(() => {
      machine.dataset.beat = "1";
      timers.push(window.setTimeout(() => { machine.dataset.beat = "2"; }, 220));
      timers.push(window.setTimeout(() => { machine.dataset.beat = "3"; }, 640));
    });
  };
  machine?.addEventListener("pointerenter", play);
  machine?.addEventListener("focus", play);
  machine?.addEventListener("click", play);
  if (machine) {
    const observer = new IntersectionObserver(([entry]) => {
      if (!entry.isIntersecting || entered) return;
      entered = true;
      play();
      observer.disconnect();
    }, { threshold: .55 });
    observer.observe(machine);
    window.addEventListener("pagehide", () => { clear(); observer.disconnect(); }, { once: true });
  }
</script>

<style>
  .machine { display: grid; align-self: center; width: 100%; padding: 0; border: 0; color: var(--color-text); background: transparent; cursor: pointer; place-items: center; }
  svg { display: block; width: 100%; max-height: 20rem; overflow: visible; }
  path, rect, circle { fill: none; stroke: currentColor; stroke-width: 1.35; vector-effect: non-scaling-stroke; }
  .axis { stroke: var(--color-border); stroke-dasharray: 2 9; }
  .endpoint, .before-shape, .branch-node { fill: var(--color-bg); }
  .input-path, .output-path { stroke: var(--color-text-sub); stroke-dasharray: 5 6; }
  .output-path { opacity: .22; }
  .signal { fill: var(--color-accent); stroke: var(--color-accent); }
  .branch, .branch-node, .smear { opacity: 0; }
  .branch, .branch-node { transform-origin: 301px 180px; }
  .smear { stroke: var(--color-accent); stroke-linecap: round; }
  .trace { stroke: var(--color-accent); stroke-width: 1.8; stroke-dasharray: 110; stroke-dashoffset: 76; opacity: .24; }
  .machine > span { justify-self: end; margin-top: -1.25rem; color: var(--color-text-sub); font: .56rem var(--font-mono); text-transform: uppercase; }
  .machine[data-beat="1"] .signal, .machine[data-beat="2"] .signal, .machine[data-beat="3"] .signal { transform: translateX(166px); transition: transform 430ms ease-out; }
  .machine[data-beat="2"] .before-shape, .machine[data-beat="3"] .before-shape { animation: transform-shape 480ms var(--ease-out-back) both; }
  .machine[data-beat="2"] .branch, .machine[data-beat="2"] .branch-node, .machine[data-beat="3"] .branch, .machine[data-beat="3"] .branch-node { opacity: 1; transition: opacity 150ms 170ms; }
  .machine[data-beat="2"] .smear, .machine[data-beat="3"] .smear { animation: smear-pass 420ms ease-out both; }
  .machine[data-beat="3"] .signal { transform: translateX(374px); transition-duration: 520ms; }
  .machine[data-beat="3"] .output-path { opacity: 1; transition: opacity 160ms; }
  .machine[data-beat="3"] .trace { opacity: 1; stroke-dashoffset: 0; transition: stroke-dashoffset 320ms ease-out 300ms, opacity 100ms 300ms; }
  @keyframes transform-shape { 0% { transform: scale(1); } 25% { transform: translateX(-10px) scale(1.18, .8); } 62% { transform: translateX(23px) scale(.82, 1.14); } 100% { transform: none; } }
  @keyframes smear-pass { 0%, 15% { opacity: 0; transform: scaleX(.2); transform-origin: left; } 45% { opacity: .65; transform: scaleX(1); } 100% { opacity: 0; transform: translateX(34px) scaleX(.35); } }
  @media (prefers-reduced-motion: reduce) { .machine[data-beat] .signal { transform: translateX(374px) !important; } .machine[data-beat] .output-path, .machine[data-beat] .branch, .machine[data-beat] .branch-node, .machine[data-beat] .trace { opacity: 1 !important; } .machine[data-beat] .trace { stroke-dashoffset: 0 !important; } .smear { display: none; } }
</style>
