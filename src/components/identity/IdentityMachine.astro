<div class="machine" data-identity-machine aria-hidden="true"><svg viewBox="0 0 560 400" role="presentation">
  <g class="grid"><path d="M80 70H485M80 160H485M80 250H485M80 340H485M125 40V365M260 40V365M395 40V365" /></g>
  <path class="connector" d="M126 118C190 118 196 195 259 195S330 100 395 100" /><path class="connector" d="M260 195C320 195 342 279 420 279" /><path class="trail" d="M118 295C185 272 227 326 304 300S390 337 475 297" />
  <circle class="node node-a" cx="126" cy="118" r="18" /><rect class="node node-b" x="242" y="177" width="36" height="36" /><path class="node node-c" d="m395 78 23 22-23 22-23-22Z" /><path class="spark" d="m420 255 6 17 18 7-18 6-6 18-6-18-18-6 18-7Z" /><path class="arrow" d="m382 95 13 5-11 8" />
  <text x="92" y="91">INPUT</text><text x="238" y="160">TRANSFORM</text><text x="371" y="62">OUTPUT</text>
</svg></div>
<script>
  const machine = document.querySelector<HTMLElement>("[data-identity-machine]");
  if (machine) { machine.addEventListener("pointermove", (event) => { const bounds = machine.getBoundingClientRect(); machine.style.setProperty("--mx", `${(event.clientX - bounds.left) / bounds.width - .5}`); machine.style.setProperty("--my", `${(event.clientY - bounds.top) / bounds.height - .5}`); }); machine.addEventListener("pointerdown", () => { machine.classList.remove("ping"); requestAnimationFrame(() => machine.classList.add("ping")); }); }
</script>
<style>
  .machine { --mx: 0; --my: 0; width: min(100%, 36rem); cursor: crosshair; user-select: none; } svg { display: block; width: 100%; overflow: visible; } .grid { opacity: .45; } .grid path { fill: none; stroke: var(--color-border); stroke-width: 1; stroke-dasharray: 2 8; }
  .node, .connector, .trail, .arrow, .spark { fill: var(--color-bg); stroke: var(--color-text); stroke-width: 1.6; vector-effect: non-scaling-stroke; } .connector { fill: none; stroke-dasharray: 6 5; } .trail { fill: none; stroke: var(--color-accent); stroke-width: 2; stroke-dasharray: 4 7; opacity: .6; }
  .node-a { transform: translate(calc(var(--mx) * 12px), calc(var(--my) * 12px)); transition: transform .16s ease-out; } .node-b { transform: translate(calc(var(--mx) * -8px), calc(var(--my) * -8px)); transition: transform .2s ease-out; } .node-c, .arrow { transform: translate(calc(var(--mx) * 5px), calc(var(--my) * 5px)); transition: transform .18s ease-out; }
  .spark { fill: var(--color-accent); stroke: var(--color-accent); transform-origin: 420px 279px; animation: breathe 3.6s ease-in-out infinite; } text { fill: var(--color-text-sub); font-family: var(--font-mono); font-size: 9px; letter-spacing: .12em; } .ping .node-b { animation: squash 580ms var(--ease-out-back); } .ping .spark { animation: pop 580ms var(--ease-out-back); }
  @keyframes breathe { 50% { transform: rotate(10deg) scale(1.08); } } @keyframes squash { 0% { transform: scale(1); } 30% { transform: scale(1.3, .65); } 65% { transform: translate(95px, 84px) scale(.75, 1.3); } 100% { transform: none; } } @keyframes pop { 0% { transform: scale(1); } 40% { transform: scale(.35) rotate(-20deg); } 75% { transform: scale(1.5) rotate(12deg); } 100% { transform: scale(1); } }
</style>
