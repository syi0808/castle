<div class="machine" data-identity-machine aria-hidden="true">
  <svg viewBox="0 0 600 440" role="presentation">
    <g class="blueprint"><path d="M35 75H565M35 220H565M35 365H565M110 40V400M300 40V400M490 40V400" /></g>

    <g class="source layer-back">
      <path class="bracket" d="M105 113H76v190h29M157 113h29v190h-29" />
      <path class="code" d="M104 153h43M96 181h62M112 209h35M96 237h55M108 265h42" />
      <circle class="port" cx="181" cy="208" r="5" />
    </g>

    <path class="signal" d="M187 208C218 208 218 155 249 155" />
    <path class="signal" d="M187 208C218 208 218 260 249 260" />
    <g class="tree layer-mid">
      <circle cx="268" cy="208" r="15" />
      <path d="M268 193v-38m0 106v-38m15-15h36" />
      <rect x="249" y="135" width="38" height="38" />
      <path d="m268 241 20 19-20 20-20-20Z" />
      <circle cx="329" cy="208" r="10" />
    </g>

    <path class="take-path" d="M339 208C370 208 372 162 405 162" />
    <path class="take-path" d="M339 208C370 208 372 275 405 275" />
    <g class="browser layer-front">
      <rect class="window" x="398" y="92" width="166" height="244" rx="3" />
      <path class="chrome" d="M398 126h166" />
      <circle class="chrome-dot" cx="416" cy="109" r="3" /><circle class="chrome-dot" cx="428" cy="109" r="3" /><circle class="chrome-dot" cx="440" cy="109" r="3" />
      <rect class="ui ui-a" x="421" y="153" width="118" height="24" rx="12" />
      <rect class="ui ui-b" x="421" y="197" width="76" height="82" />
      <circle class="ui ui-c" cx="522" cy="238" r="18" />
      <path class="scribble" d="M416 302c23-9 35 8 57 0s38 7 67-2" />
      <path class="cursor" d="m510 256 5 29 8-9 9 12 7-5-9-12 12-4Z" />
    </g>

    <path class="spark" d="m357 79 5 14 14 5-14 5-5 14-5-14-14-5 14-5Z" />
  </svg>
</div>

<script>
  const machine = document.querySelector<HTMLElement>("[data-identity-machine]");
  if (machine) {
    machine.addEventListener("pointermove", (event) => {
      const bounds = machine.getBoundingClientRect();
      machine.style.setProperty("--mx", `${(event.clientX - bounds.left) / bounds.width - .5}`);
      machine.style.setProperty("--my", `${(event.clientY - bounds.top) / bounds.height - .5}`);
    });
    machine.addEventListener("pointerdown", () => {
      machine.classList.remove("ping");
      requestAnimationFrame(() => machine.classList.add("ping"));
    });
  }
</script>

<style>
  .machine { --mx: 0; --my: 0; width: min(100%, 40rem); cursor: crosshair; user-select: none; }
  svg { display: block; width: 100%; overflow: visible; }
  path, rect, circle { fill: none; stroke: var(--color-text); stroke-width: 1.45; vector-effect: non-scaling-stroke; }
  .blueprint { opacity: .42; }
  .blueprint path { stroke: var(--color-border); stroke-width: 1; stroke-dasharray: 2 9; }
  .bracket, .code { stroke: var(--color-text-sub); }
  .code { stroke-dasharray: 2 2; }
  .signal, .take-path { stroke: var(--color-text-sub); stroke-dasharray: 5 6; }
  .port, .tree circle, .tree rect, .tree > path { fill: var(--color-bg); }
  .window { fill: color-mix(in srgb, var(--color-bg) 90%, transparent); }
  .chrome-dot { fill: var(--color-border); stroke: none; }
  .ui { fill: var(--color-surface); }
  .ui-a { stroke: var(--color-accent); }
  .ui-c { fill: var(--color-bg); }
  .scribble { stroke: var(--color-accent); stroke-width: 2; }
  .cursor { fill: var(--color-text); stroke: var(--color-bg); stroke-width: 3; }
  .spark { fill: var(--color-accent); stroke: var(--color-accent); transform-origin: 357px 98px; animation: breathe 4s ease-in-out infinite; }
  .layer-back { transform: translate(calc(var(--mx) * 8px), calc(var(--my) * 8px)); transition: transform 180ms ease-out; }
  .layer-mid { transform: translate(calc(var(--mx) * -7px), calc(var(--my) * -7px)); transition: transform 220ms ease-out; }
  .layer-front { transform: translate(calc(var(--mx) * 4px), calc(var(--my) * 4px)); transition: transform 160ms ease-out; }
  .ping .tree { animation: transform-node 620ms var(--ease-out-back); transform-origin: 268px 208px; }
  .ping .ui-a { animation: interface-pop 620ms var(--ease-out-back); transform-origin: 480px 165px; }
  .ping .cursor { animation: cursor-click 620ms var(--ease-out-back); transform-origin: 521px 273px; }
  @keyframes breathe { 50% { transform: rotate(12deg) scale(1.12); } }
  @keyframes transform-node { 0% { transform: scale(1); } 28% { transform: scale(1.25, .72); } 62% { transform: translateX(64px) scale(.78, 1.2); } 100% { transform: none; } }
  @keyframes interface-pop { 0%, 42% { transform: scaleX(.35); opacity: .25; } 72% { transform: scaleX(1.1); } 100% { transform: scale(1); opacity: 1; } }
  @keyframes cursor-click { 35% { transform: translate(-7px, -8px); } 55% { transform: translate(-4px, -4px) scale(.82); } 100% { transform: none; } }
</style>
