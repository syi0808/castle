---
import "../styles/global.css";
interface Props { title: string; }
const { title } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <script is:inline>
      const saved = localStorage.getItem("theme");
      if (saved === "dark" || (!saved && window.matchMedia("(prefers-color-scheme: dark)").matches)) document.documentElement.classList.add("dark");
    </script>
  </head>
  <body>
    <a class="lab-return" href={`${import.meta.env.BASE_URL}lab`}>← Lab</a>
    <slot />
  </body>
</html>

<style is:global>
  .lab-return { position: fixed; z-index: 100; top: 1.25rem; left: 1.5rem; padding: .45rem .65rem; border: 1px solid var(--color-border); color: var(--color-text-sub); background: color-mix(in srgb, var(--color-bg) 88%, transparent); font-size: .72rem; text-decoration: none; backdrop-filter: blur(8px); }
  .lab-return:hover, .lab-return:focus-visible { color: var(--color-text); }
</style>
