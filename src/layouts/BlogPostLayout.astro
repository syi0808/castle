---
import BaseLayout from "./BaseLayout.astro";
import PostMeta from "../components/PostMeta.astro";
import TableOfContents from "../components/TableOfContents.astro";
import RelatedPosts from "../components/RelatedPosts.astro";
import PrevNextNav from "../components/PrevNextNav.astro";
import JsonLd from "../components/JsonLd.astro";
import CopyCodeButton from "../components/CopyCodeButton.astro";
import Giscus from "../components/Giscus.astro";
import { getReadingTime } from "../lib/reading-time";
import { SITE, AUTHOR } from "../lib/seo";
import type { BlogPost } from "../lib/posts";
interface Props { post: BlogPost; headings: { depth: number; slug: string; text: string }[]; content: string; relatedPosts: BlogPost[]; prevPost: BlogPost | null; nextPost: BlogPost | null; }
const { post, headings, content, relatedPosts, prevPost, nextPost } = Astro.props;
const readingTime = getReadingTime(content); const postUrl = `${SITE.url}/${post.id}/`; const ogImage = post.data.image ? `${SITE.url}/${post.data.image.replace(/^\//, "")}` : `${SITE.url}/og-default.png`;
const jsonLd = { "@context": "https://schema.org", "@type": "BlogPosting", headline: post.data.title, description: post.data.description, datePublished: post.data.date.toISOString(), dateModified: (post.data.updatedDate ?? post.data.date).toISOString(), author: { "@type": "Person", name: AUTHOR.name, url: AUTHOR.url }, mainEntityOfPage: postUrl, image: ogImage, inLanguage: SITE.lang, keywords: post.data.tags.join(", ") };
---
<BaseLayout title={`${post.data.title} — Yein Sung`} description={post.data.description} image={post.data.image} type="article" publishedDate={post.data.date.toISOString()} modifiedDate={post.data.updatedDate?.toISOString()}>
  <JsonLd data={jsonLd} /><article class="article-shell"><header><PostMeta date={post.data.date} readingTime={readingTime} tags={post.data.tags} /><h1>{post.data.title}</h1></header>
    <TableOfContents headings={headings} /><div class="article-body"><div class="prose"><slot /></div><RelatedPosts posts={relatedPosts} /><PrevNextNav prev={prevPost} next={nextPost} /><Giscus /></div>
  </article><CopyCodeButton />
</BaseLayout>
<style>
  .article-shell { width: min(calc(100% - 3rem), 1040px); margin: 0 auto; padding: clamp(4rem, 9vw, 8rem) 0 2rem; } header { max-width: 680px; margin: 0 auto clamp(4rem, 8vw, 6rem); } h1 { max-width: 680px; margin: 1.2rem 0 0; font-size: clamp(2.15rem, 4.8vw, 4.15rem); font-weight: 500; letter-spacing: -.055em; line-height: 1.02; } .article-body { max-width: 680px; margin-inline: auto; }
  @media (max-width: 700px) { .article-shell { width: min(calc(100% - 2rem), 1040px); } }
</style>
