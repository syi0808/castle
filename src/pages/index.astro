---
import BaseLayout from "../layouts/BaseLayout.astro";
import IdentityHero from "../components/identity/IdentityHero.astro";
import SelectedWork from "../components/work/SelectedWork.astro";
import WritingIndex from "../components/writing/WritingIndex.astro";
import JsonLd from "../components/JsonLd.astro";
import { getSortedPosts } from "../lib/posts";
import { SITE, AUTHOR } from "../lib/seo";
const recentPosts = (await getSortedPosts()).slice(0, 5);
const jsonLd = [{ "@context": "https://schema.org", "@type": "WebSite", name: SITE.title, url: SITE.url, inLanguage: SITE.lang }, { "@context": "https://schema.org", "@type": "Person", name: AUTHOR.name, url: SITE.url, sameAs: [AUTHOR.github] }];
---
<BaseLayout title="Yein Sung — Software Engineer" description="Tools, interfaces, open source, and writing by Yein Sung.">
  {jsonLd.map((data) => <JsonLd data={data} />)}
  <IdentityHero />
  <SelectedWork />
  <WritingIndex posts={recentPosts} />
</BaseLayout>
