---
import LabLayout from "../../layouts/LabLayout.astro";
import { getSortedPosts } from "../../lib/posts";

const posts = (await getSortedPosts()).slice(0, 3);
const formatDate = (date: Date) => `${String(date.getMonth() + 1).padStart(2, "0")}.${String(date.getDate()).padStart(2, "0")}`;
---

<LabLayout title="Cinematic Contact Sheet">
  <main class="contact-landing" data-contact-landing>
    <section class="hero-frame">
      <div class="hero-copy">
        <h1>Yein Sung</h1>
        <p>I make tools, interfaces,<br />and things I wish existed.</p>
      </div>

      <nav class="contact-sheet" aria-label="Selected work">
        <a href="#rougher-stuff" class="contact-cell rougher-cell">
          <span class="cell-meta"><b>01</b><strong>rougher-stuff</strong></span>
          <span class="mini-rough" data-mini-rough>underline</span>
        </a>
        <a href="#trandimation" class="contact-cell tradimation-cell">
          <span class="cell-meta"><b>02</b><strong>trandimation</strong></span>
          <span class="mini-motion"><span class="point"></span><span class="object">same element</span><span class="point"></span></span>
        </a>
        <a href="#svgr2" class="contact-cell svgr2-cell">
          <span class="cell-meta"><b>03</b><strong>svgr2</strong></span>
          <span class="mini-svgr"><svg viewBox="0 0 16 16" role="presentation"><path d="M8 1l7 14H1L8 1z" /></svg><code>&lt;Icon /&gt;</code></span>
        </a>
      </nav>
    </section>

    <section id="rougher-stuff" class="project-chapter rougher-chapter" data-chapter="rougher-stuff">
      <div class="chapter-frame">
        <header class="chapter-head">
          <span>01 / 03</span>
          <h2>rougher-stuff</h2>
          <p>expressive web primitives</p>
        </header>
        <div class="rougher-proof" data-rougher-proof>
          <span data-rough="underline">underline</span>
          <span data-rough="circle">circle</span>
          <span data-rough="bracket">bracket</span>
        </div>
      </div>
    </section>

    <section id="trandimation" class="project-chapter tradimation-chapter" data-chapter="trandimation">
      <div class="chapter-frame">
        <header class="chapter-head">
          <span>02 / 03</span>
          <h2>trandimation</h2>
          <p>traditional UI motion</p>
        </header>
        <div class="tradimation-proof" data-tradimation-proof>
          <div class="motion-baseline"></div>
          <div class="source-registration"><span>origin</span></div>
          <div class="specimen-origin"><div class="specimen" data-specimen>same element</div></div>
          <svg class="destination-registration" data-destination viewBox="0 0 32 32" role="presentation">
            <path d="M16 0v10M16 22v10M0 16h10M22 16h10" />
            <circle cx="16" cy="16" r="5" />
          </svg>
        </div>
      </div>
    </section>

    <section id="svgr2" class="project-chapter svgr2-chapter" data-chapter="svgr2">
      <div class="chapter-frame">
        <header class="chapter-head">
          <span>03 / 03</span>
          <h2>svgr2</h2>
          <p>SVG to component tooling</p>
        </header>
        <div class="svgr2-proof" data-svgr2-proof>
          <div class="fixture">
            <svg viewBox="0 0 16 16" role="presentation"><path d="M8 1l7 14H1L8 1z" /></svg>
            <div class="representation"><code data-source>&lt;svg&gt;</code><code data-result>&lt;Icon /&gt;</code></div>
          </div>
          <div class="benchmark"><strong>29.99×</strong><span>JSX · tiny fixture</span></div>
        </div>
      </div>
    </section>

    <section class="writing-frame">
      <header><h2>Writing</h2><span>Recent notes</span></header>
      <ol>
        {posts.map((post) => (
          <li><time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time><strong>{post.data.title}</strong></li>
        ))}
      </ol>
    </section>
  </main>
</LabLayout>

<script>
  import { annotate, annotationGroup } from "@rougher-stuff/rough-notation";
  import type { RoughAnnotation, RoughAnnotationGroup } from "@rougher-stuff/rough-notation";
  import { createEffect } from "@tradimation/core";
  import type { EffectController } from "@tradimation/core";

  type ProjectKey = "rougher-stuff" | "trandimation" | "svgr2";

  const root = document.querySelector<HTMLElement>("[data-contact-landing]");
  const chapters = [...(root?.querySelectorAll<HTMLElement>("[data-chapter]") ?? [])];
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const played = new Set<ProjectKey>();
  const annotations: RoughAnnotation[] = [];

  let rougherGroup: RoughAnnotationGroup | undefined;
  let tradimationController: EffectController | undefined;
  let svgr2Controller: EffectController | undefined;

  const measureTradimation = () => {
    const proof = root?.querySelector<HTMLElement>("[data-tradimation-proof]");
    const specimen = proof?.querySelector<HTMLElement>("[data-specimen]");
    const destination = proof?.querySelector<SVGElement>("[data-destination]");
    if (!proof || !specimen || !destination) return 0;
    const origin = proof.clientWidth * (window.innerWidth <= 700 ? .08 : .13);
    const desired = window.innerWidth <= 700 ? 118 : 260;
    const distance = Math.max(76, Math.min(desired, proof.clientWidth - origin - specimen.offsetWidth - 32));
    destination.style.left = `${origin + specimen.offsetWidth / 2 + distance}px`;
    return distance;
  };

  const settle = (project: ProjectKey) => {
    if (project === "rougher-stuff") rougherGroup?.show({ duration: 0 });
    if (project === "trandimation") {
      const proof = root?.querySelector<HTMLElement>("[data-tradimation-proof]");
      const specimen = proof?.querySelector<HTMLElement>("[data-specimen]");
      const destination = proof?.querySelector<SVGElement>("[data-destination]");
      if (specimen) specimen.style.transform = `translateX(${measureTradimation()}px)`;
      destination?.classList.add("settled");
    }
    if (project === "svgr2") {
      const proof = root?.querySelector<HTMLElement>("[data-svgr2-proof]");
      const source = proof?.querySelector<HTMLElement>("[data-source]");
      const result = proof?.querySelector<HTMLElement>("[data-result]");
      if (source) {
        source.style.visibility = "hidden";
        source.style.transform = "scale(1)";
      }
      if (result) {
        result.style.visibility = "visible";
        result.style.transform = "scale(1)";
      }
    }
  };

  const activate = (project: ProjectKey) => {
    if (played.has(project) || reducedMotion) {
      settle(project);
      played.add(project);
      return;
    }

    if (project === "rougher-stuff") {
      rougherGroup?.show({ duration: 1180 });
      played.add(project);
      return;
    }

    if (project === "trandimation") {
      const proof = root?.querySelector<HTMLElement>("[data-tradimation-proof]");
      const specimen = proof?.querySelector<HTMLElement>("[data-specimen]");
      if (!proof || !specimen) return;
      const distance = measureTradimation();
      specimen.style.transform = "translateX(0)";
      try {
        const controller = createEffect(specimen, "smear", { overlayRoot: proof, distance, duration: 670, cleanup: "commit" });
        tradimationController = controller;
        void controller.play().then(() => {
          settle(project);
          played.add(project);
          if (tradimationController === controller) tradimationController = undefined;
        });
      } catch {
        settle(project);
        played.add(project);
      }
      return;
    }

    const proof = root?.querySelector<HTMLElement>("[data-svgr2-proof]");
    const source = proof?.querySelector<HTMLElement>("[data-source]");
    const result = proof?.querySelector<HTMLElement>("[data-result]");
    if (!source || !result) return;
    try {
      const controller = createEffect(source, "compress-swap", { secondary: result, duration: 780 });
      svgr2Controller = controller;
      void controller.play().then(() => {
        settle(project);
        played.add(project);
        if (svgr2Controller === controller) svgr2Controller = undefined;
      });
    } catch {
      settle(project);
      played.add(project);
    }
  };

  const deactivate = (project: ProjectKey) => {
    if (project === "rougher-stuff") rougherGroup?.hide();
    if (project === "trandimation" && tradimationController) {
      tradimationController.destroy();
      tradimationController = undefined;
      settle(project);
      played.add(project);
    }
    if (project === "svgr2" && svgr2Controller) {
      svgr2Controller.destroy();
      svgr2Controller = undefined;
      settle(project);
      played.add(project);
    }
  };

  const setup = async () => {
    if (!root) return;
    await document.fonts.ready;
    await new Promise<void>((resolve) => requestAnimationFrame(() => resolve()));
    const accent = getComputedStyle(document.documentElement).getPropertyValue("--color-accent").trim();
    const miniRough = root.querySelector<HTMLElement>("[data-mini-rough]");
    if (miniRough) {
      const annotation = annotate(miniRough, { type: "underline", color: accent, strokeWidth: 1.7, iterations: 1, roughness: 1.25, seed: 43, padding: [0, 1, 4, 1], animationDuration: 0 });
      annotations.push(annotation);
      annotation.show({ duration: 0 });
    }

    const proof = root.querySelector<HTMLElement>("[data-rougher-proof]");
    const underline = proof?.querySelector<HTMLElement>("[data-rough='underline']");
    const circle = proof?.querySelector<HTMLElement>("[data-rough='circle']");
    const bracket = proof?.querySelector<HTMLElement>("[data-rough='bracket']");
    if (underline && circle && bracket) {
      const groupAnnotations = [
        annotate(underline, { type: "underline", color: accent, strokeWidth: 2, iterations: 1, roughness: 1.25, seed: 43, padding: [0, 2, 8, 2], animationDuration: 420 }),
        annotate(circle, { type: "circle", color: accent, strokeWidth: 2, iterations: 1, roughness: 1.25, seed: 43, padding: 12, animationDuration: 520 }),
        annotate(bracket, { type: "bracket", brackets: ["right"], color: accent, strokeWidth: 2, iterations: 1, roughness: 1.25, seed: 43, padding: 12, animationDuration: 420 }),
      ];
      annotations.push(...groupAnnotations);
      rougherGroup = annotationGroup(groupAnnotations);
    }

    const specimen = root.querySelector<HTMLElement>("[data-specimen]");
    const source = root.querySelector<HTMLElement>("[data-source]");
    const result = root.querySelector<HTMLElement>("[data-result]");
    if (!reducedMotion) {
      if (specimen) specimen.style.transform = "translateX(0)";
      if (source) source.style.visibility = "visible";
      if (result) result.style.visibility = "hidden";
    } else {
      settle("rougher-stuff");
      settle("trandimation");
      settle("svgr2");
    }

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        const project = (entry.target as HTMLElement).dataset.chapter as ProjectKey | undefined;
        if (!project) return;
        if (entry.isIntersecting) activate(project);
        else deactivate(project);
      });
    }, { rootMargin: "-38% 0px -38% 0px" });

    chapters.forEach((chapter) => observer.observe(chapter));
    window.addEventListener("resize", () => {
      if (played.has("trandimation")) settle("trandimation");
    }, { passive: true });
    window.addEventListener("pagehide", () => {
      observer.disconnect();
      tradimationController?.destroy();
      svgr2Controller?.destroy();
      annotations.forEach((annotation) => annotation.remove());
    }, { once: true });
  };

  void setup();
</script>

<style>
  .contact-landing { background: var(--color-bg); }
  .hero-frame { display: grid; min-height: 100svh; padding: clamp(6rem, 10vh, 8rem) clamp(1rem, 4vw, 4rem) clamp(1rem, 2vw, 2rem); grid-template-rows: 1fr auto; }
  .hero-copy { display: flex; justify-content: space-between; gap: 3rem; }
  .hero-copy h1 { margin: 0; font-size: clamp(5.5rem, 13vw, 13rem); font-weight: 500; letter-spacing: -.085em; line-height: .76; }
  .hero-copy p { align-self: end; margin: 0 2vw 10vh 0; font-size: clamp(1.5rem, 3vw, 3rem); font-weight: 500; letter-spacing: -.045em; line-height: 1.08; }
  .contact-sheet { display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border); }
  .contact-cell { display: grid; min-height: clamp(10rem, 17vh, 13rem); padding: 1rem; border-right: 1px solid var(--color-border); text-decoration: none; grid-template-rows: auto 1fr; }
  .contact-cell:last-child { border-right: 0; }
  .contact-cell:hover, .contact-cell:focus-visible { background: var(--color-surface); }
  .cell-meta { display: grid; grid-template-columns: 2.2rem 1fr; align-items: baseline; }
  .cell-meta b { color: var(--color-accent); font: 400 .64rem var(--font-mono); }
  .cell-meta strong { font-size: clamp(1rem, 1.7vw, 1.4rem); font-weight: 500; letter-spacing: -.035em; }
  .mini-rough { align-self: center; justify-self: center; width: fit-content; font-size: clamp(1.4rem, 2.8vw, 2.4rem); font-weight: 500; }
  .mini-motion { position: relative; display: grid; align-self: center; grid-template-columns: 1rem 1fr 1rem; align-items: center; gap: .6rem; }
  .mini-motion::before { position: absolute; right: 1rem; left: 1rem; height: 1px; background: var(--color-border); content: ""; }
  .mini-motion .point { z-index: 1; width: .55rem; height: .55rem; border: 1px solid var(--color-accent); border-radius: 50%; background: var(--color-bg); }
  .mini-motion .object { z-index: 1; justify-self: center; padding: .45rem .75rem; border: 1px solid var(--color-text); border-radius: 5px; background: var(--color-bg); font-size: .7rem; }
  .mini-svgr { display: flex; align-self: center; align-items: center; justify-content: center; gap: 1.5rem; }
  .mini-svgr svg { width: 3rem; }
  .mini-svgr path { fill: none; stroke: var(--color-text); stroke-width: .7; }
  .mini-svgr code { font: .8rem var(--font-mono); }
  .project-chapter { position: relative; min-height: 138svh; scroll-margin-top: 0; }
  .chapter-frame { position: sticky; top: 0; display: grid; height: 100svh; overflow: hidden; padding: clamp(5rem, 8vh, 7rem) clamp(1rem, 4vw, 4rem) clamp(2rem, 4vh, 3rem); grid-template-rows: auto 1fr; }
  .chapter-head { display: grid; grid-template-columns: 4rem 1fr auto; align-items: baseline; }
  .chapter-head > span { color: var(--chapter-sub); font: .65rem var(--font-mono); }
  .chapter-head h2 { margin: 0; font-size: clamp(3.8rem, 9vw, 9rem); font-weight: 500; letter-spacing: -.075em; line-height: .8; }
  .chapter-head p { margin: 0; color: var(--chapter-sub); font-size: .76rem; }
  .rougher-chapter { --chapter-sub: var(--color-text-sub); color: var(--color-text); background: var(--color-surface); }
  .rougher-proof { display: grid; grid-template-columns: repeat(12, 1fr); grid-template-rows: repeat(3, 1fr); align-self: center; align-items: center; width: min(86vw, 70rem); height: min(52vh, 31rem); justify-self: center; }
  .rougher-proof span { width: fit-content; font-size: clamp(2.8rem, 6vw, 6rem); font-weight: 500; letter-spacing: -.055em; line-height: .9; }
  [data-rough="underline"] { grid-column: 1 / 7; grid-row: 1; }
  [data-rough="circle"] { grid-column: 7 / 13; grid-row: 2; justify-self: end; }
  [data-rough="bracket"] { grid-column: 3 / 10; grid-row: 3; }
  .trandimation-chapter { --chapter-sub: #a8a39a; color: #f4f1ea; background: #1d1c1a; }
  .tradimation-proof { position: relative; align-self: center; width: min(78vw, 66rem); height: min(44vh, 25rem); overflow: hidden; justify-self: center; }
  .motion-baseline { position: absolute; top: 50%; right: 6%; left: 6%; height: 1px; background: color-mix(in srgb, #f4f1ea 18%, transparent); }
  .source-registration { position: absolute; top: 50%; left: 13%; width: 1rem; height: 1rem; border: 1px solid #a8a39a; border-radius: 50%; transform: translate(-50%, -50%); }
  .source-registration span { position: absolute; top: 1.2rem; left: 50%; color: #a8a39a; font: .6rem var(--font-mono); transform: translateX(-50%); }
  .specimen-origin { position: absolute; top: 50%; left: 13%; transform: translateY(-50%); }
  .specimen { display: grid; width: 190px; height: 74px; border: 2px solid #f4f1ea; border-radius: 10px; color: #1d1c1a; background: var(--color-accent); box-shadow: 6px 6px 0 #f4f1ea; font-size: 1.08rem; font-weight: 600; letter-spacing: -.035em; place-items: center; transform: translateX(min(260px, 30vw)); }
  .destination-registration { position: absolute; top: 50%; width: 32px; height: 32px; color: var(--color-accent); opacity: .5; transform: translate(-50%, -50%); }
  .destination-registration path, .destination-registration circle { fill: none; stroke: currentColor; stroke-width: 1; vector-effect: non-scaling-stroke; }
  .destination-registration.settled { opacity: .95; }
  .svgr2-chapter { --chapter-sub: var(--color-text-sub); color: var(--color-text); background: var(--color-bg); }
  .svgr2-proof { position: relative; display: grid; align-self: center; width: min(76vw, 64rem); min-height: min(50vh, 30rem); place-items: center; justify-self: center; }
  .fixture { display: grid; gap: 1.8rem; place-items: center; }
  .fixture svg { width: clamp(9rem, 19vw, 16rem); overflow: visible; }
  .fixture path { fill: none; stroke: var(--color-text); stroke-width: .7; vector-effect: non-scaling-stroke; }
  .representation { position: relative; display: grid; min-width: 9rem; height: 2.5rem; place-items: center; }
  .representation code { position: absolute; font: 500 clamp(1.2rem, 2vw, 1.7rem) var(--font-mono); transform-origin: left center; white-space: nowrap; }
  [data-source] { visibility: hidden; }
  [data-result] { visibility: visible; }
  .benchmark { position: absolute; right: 0; bottom: 0; display: grid; justify-items: end; }
  .benchmark strong { color: var(--color-accent); font-size: clamp(2.2rem, 5vw, 4.5rem); font-weight: 500; letter-spacing: -.055em; line-height: .9; }
  .benchmark span { margin-top: .5rem; color: var(--color-text-sub); font: .68rem var(--font-mono); }
  .writing-frame { width: min(calc(100% - 3rem), 1180px); margin: 0 auto; padding: clamp(10rem, 18vw, 16rem) 0 8rem; }
  .writing-frame header { display: flex; align-items: end; justify-content: space-between; margin-bottom: clamp(3rem, 7vw, 6rem); }
  .writing-frame h2 { margin: 0; font-size: clamp(4.5rem, 10vw, 9rem); font-weight: 500; letter-spacing: -.075em; line-height: .8; }
  .writing-frame header span { color: var(--color-text-sub); font: .68rem var(--font-mono); }
  .writing-frame ol { margin: 0; padding: 0; border-top: 1px solid var(--color-border); list-style: none; }
  .writing-frame li { display: grid; grid-template-columns: 5rem 1fr; align-items: center; min-height: clamp(5rem, 9vw, 7.5rem); border-bottom: 1px solid var(--color-border); }
  .writing-frame time { color: var(--color-text-sub); font: .68rem var(--font-mono); }
  .writing-frame strong { font-size: clamp(1.15rem, 2.2vw, 1.75rem); font-weight: 500; letter-spacing: -.025em; line-height: 1.25; }
  @media (max-width: 700px) {
    .hero-frame { min-height: 100svh; padding-top: 5rem; }
    .hero-copy { display: block; }
    .hero-copy h1 { font-size: clamp(4.5rem, 20vw, 6.5rem); }
    .hero-copy p { margin: 3rem 0 2rem; font-size: clamp(1.4rem, 6.5vw, 2rem); }
    .contact-sheet { grid-template-columns: 1fr; }
    .contact-cell { min-height: 5.5rem; border-right: 0; border-bottom: 1px solid var(--color-border); grid-template-columns: 1fr 1fr; grid-template-rows: 1fr; align-items: center; }
    .contact-cell:last-child { border-bottom: 0; }
    .mini-rough { font-size: 1.5rem; }
    .mini-motion { width: 100%; }
    .mini-svgr svg { width: 2rem; }
    .project-chapter { min-height: 124svh; }
    .chapter-frame { padding: 5.5rem 1rem 2rem; }
    .chapter-head { grid-template-columns: 2.8rem 1fr; }
    .chapter-head h2 { font-size: min(14vw, 4.5rem); }
    .chapter-head p { display: none; }
    .rougher-proof { width: calc(100vw - 2rem); height: 48vh; }
    .rougher-proof span { font-size: clamp(2.6rem, 13vw, 4.5rem); }
    [data-rough="underline"] { grid-column: 1 / 11; }
    [data-rough="circle"] { grid-column: 4 / 13; }
    [data-rough="bracket"] { grid-column: 2 / 11; }
    .tradimation-proof { width: calc(100vw - 2rem); height: 48vh; }
    .source-registration, .specimen-origin { left: 8%; }
    .specimen { width: 150px; height: 60px; font-size: .92rem; transform: translateX(118px); }
    .svgr2-proof { width: calc(100vw - 2rem); min-height: 50vh; }
    .benchmark { right: .5rem; bottom: 1rem; }
    .writing-frame { width: calc(100% - 2rem); padding-top: 9rem; }
    .writing-frame h2 { font-size: clamp(4rem, 20vw, 6rem); }
    .writing-frame header span { display: none; }
    .writing-frame li { grid-template-columns: 3.75rem 1fr; min-height: 5.5rem; }
    .writing-frame strong { font-size: 1.05rem; }
  }
  @media (prefers-reduced-motion: reduce) { .contact-cell { scroll-behavior: auto; } }
</style>
