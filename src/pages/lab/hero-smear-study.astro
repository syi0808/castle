---
import LabLayout from "../../layouts/LabLayout.astro";
---

<LabLayout title="Hero Smear Study">
  <main class="hero-study">
    <div class="identity">
      <h1>Yein Sung</h1>
      <p>I make tools, interfaces,<br />and things I wish existed.</p>
    </div>

    <div class="motion-stage" data-motion-stage>
      <div class="card-origin"><div class="specimen-card" data-specimen-card>trandimation</div></div>
      <svg class="registration" data-registration viewBox="0 0 32 32" aria-hidden="true">
        <path d="M16 0v10M16 22v10M0 16h10M22 16h10" />
        <circle cx="16" cy="16" r="5" />
      </svg>
      <button type="button" data-replay>Replay</button>
    </div>
  </main>
</LabLayout>

<script>
  import { createEffect } from "@tradimation/core";
  import type { EffectController } from "@tradimation/core";

  const stage = document.querySelector<HTMLElement>("[data-motion-stage]");
  const card = document.querySelector<HTMLElement>("[data-specimen-card]");
  const registration = document.querySelector<SVGElement>("[data-registration]");
  const replay = document.querySelector<HTMLButtonElement>("[data-replay]");
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  let controller: EffectController | undefined;
  let running = false;
  let settled = false;
  let distance = 0;

  const measure = () => {
    if (!stage || !card || !registration) return;
    const origin = stage.clientWidth * (window.innerWidth <= 700 ? .1 : .14);
    const desired = window.innerWidth <= 700 ? 110 : 220;
    const available = stage.clientWidth - origin - card.offsetWidth - 28;
    distance = Math.max(72, Math.min(desired, available));
    registration.style.left = `${origin + card.offsetWidth / 2 + distance}px`;
    if (settled) card.style.transform = `translateX(${distance}px)`;
  };

  const settleWithoutMotion = () => {
    if (!card || !registration) return;
    card.style.transform = `translateX(${distance}px)`;
    registration.classList.add("settled");
    settled = true;
  };

  const play = async () => {
    if (!stage || !card || !registration || running) return;
    running = true;
    settled = false;
    registration.classList.remove("settled");
    controller?.destroy();
    card.removeAttribute("style");
    measure();

    if (reducedMotion) {
      settleWithoutMotion();
      running = false;
      return;
    }

    try {
      controller = createEffect(card, "smear", {
        overlayRoot: stage,
        distance,
        duration: 670,
        cleanup: "commit",
      });
      await controller.play();
      registration.classList.add("settled");
      settled = true;
    } catch {
      settleWithoutMotion();
    } finally {
      running = false;
    }
  };

  const setup = async () => {
    await document.fonts.ready;
    await new Promise<void>((resolve) => requestAnimationFrame(() => resolve()));
    measure();

    if (reducedMotion) {
      settleWithoutMotion();
      return;
    }

    const observer = new IntersectionObserver((entries) => {
      if (!entries.some((entry) => entry.isIntersecting)) return;
      observer.disconnect();
      window.setTimeout(() => { void play(); }, 420);
    }, { threshold: .55 });
    if (stage) observer.observe(stage);

    replay?.addEventListener("click", () => { void play(); });
    window.addEventListener("resize", measure, { passive: true });
    window.addEventListener("pagehide", () => {
      observer.disconnect();
      controller?.destroy();
    }, { once: true });
  };

  void setup();
</script>

<style>
  .hero-study { display: grid; grid-template-columns: minmax(0, 1.12fr) minmax(28rem, .88fr); align-items: center; min-height: 100svh; gap: clamp(2rem, 4vw, 6rem); padding: clamp(1.5rem, 4vw, 4rem); }
  .identity { align-self: stretch; display: flex; flex-direction: column; justify-content: space-between; padding: 19vh 0 8vh; }
  h1 { margin: 0; font-size: clamp(6rem, 12vw, 12.5rem); font-weight: 500; letter-spacing: -.085em; line-height: .76; }
  p { margin: 0; font-size: clamp(1.5rem, 2.4vw, 2.35rem); font-weight: 500; letter-spacing: -.04em; line-height: 1.15; }
  .motion-stage { position: relative; aspect-ratio: 4 / 3; overflow: hidden; background-image: linear-gradient(color-mix(in srgb, var(--color-text) 5%, transparent) 1px, transparent 1px), linear-gradient(90deg, color-mix(in srgb, var(--color-text) 5%, transparent) 1px, transparent 1px); background-size: 24px 24px; }
  .card-origin { position: absolute; top: 50%; left: 14%; transform: translateY(-50%); }
  .specimen-card { display: grid; width: 190px; height: 74px; border: 2px solid var(--color-text); border-radius: 10px; color: var(--color-bg); background: var(--color-accent); box-shadow: 6px 6px 0 var(--color-text); font-size: 1.15rem; font-weight: 600; letter-spacing: -.035em; line-height: 1; place-items: center; transform-origin: center; }
  .registration { position: absolute; top: 50%; width: 32px; height: 32px; color: var(--color-accent); opacity: .45; transform: translate(-50%, -50%); transition: opacity 180ms ease-out; }
  .registration path, .registration circle { fill: none; stroke: currentColor; stroke-width: 1; vector-effect: non-scaling-stroke; }
  .registration.settled { opacity: .8; }
  button { position: absolute; right: 1rem; bottom: 1rem; padding: .45rem .7rem; border: 1px solid var(--color-border); color: var(--color-text-sub); background: color-mix(in srgb, var(--color-bg) 88%, transparent); font: .7rem var(--font-mono); cursor: pointer; }
  button:hover, button:focus-visible { border-color: var(--color-text-sub); color: var(--color-text); }

  @media (max-width: 900px) {
    .hero-study { grid-template-columns: 1fr; align-content: start; min-height: 0; gap: 4rem; padding: 5rem 1.25rem 3rem; }
    .identity { min-height: 62svh; padding: 8vh 0 0; }
    h1 { font-size: clamp(5.5rem, 23vw, 9rem); }
    p { font-size: clamp(1.4rem, 6vw, 2rem); }
    .motion-stage { width: 100%; }
    .card-origin { left: 10%; }
    .specimen-card { width: 150px; height: 60px; border-radius: 8px; box-shadow: 5px 5px 0 var(--color-text); font-size: .95rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .registration { transition: none; }
  }
</style>
