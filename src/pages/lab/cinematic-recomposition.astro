---
import LabLayout from "../../layouts/LabLayout.astro";
import { getSortedPosts } from "../../lib/posts";

const posts = (await getSortedPosts()).slice(0, 3);
const formatDate = (date: Date) => `${String(date.getMonth() + 1).padStart(2, "0")}.${String(date.getDate()).padStart(2, "0")}`;
const scenes = ["identity", "rougher-stuff", "trandimation", "svgr2"];
---

<LabLayout title="Cinematic Recomposition — Prototype B">
  <main class="recomposition" data-recomposition>
    <section class="sequence">
      <div class="stage" data-stage>
        <div class="title-stack" aria-live="polite">
          <h1 data-title="identity">Yein Sung</h1>
          <h2 data-title="rougher-stuff" aria-hidden="true" inert>rougher-stuff</h2>
          <h2 data-title="trandimation" aria-hidden="true" inert>trandimation</h2>
          <h2 data-title="svgr2" aria-hidden="true" inert>svgr2</h2>
        </div>

        <p class="intro" data-intro>I make tools, interfaces,<br />and things I wish existed.</p>
        <span class="chapter-number" data-chapter-number aria-hidden="true">01 / 03</span>

        <div class="proof-stack">
          <div class="proof rougher-proof" data-proof="rougher-stuff" aria-hidden="true">
            <span data-notation="underline">underline</span>
            <span data-notation="circle">circle</span>
            <span data-notation="bracket">bracket</span>
          </div>

          <div class="proof tradimation-proof" data-proof="trandimation" aria-hidden="true">
            <div class="motion-field" data-motion-field>
              <div class="specimen-origin"><div class="specimen" data-motion-specimen>same element</div></div>
              <svg class="registration" data-motion-registration viewBox="0 0 32 32" role="presentation">
                <path d="M16 0v10M16 22v10M0 16h10M22 16h10" />
                <circle cx="16" cy="16" r="5" />
              </svg>
            </div>
          </div>

          <div class="proof svgr2-proof" data-proof="svgr2" aria-hidden="true">
            <div class="fixture">
              <svg viewBox="0 0 16 16" role="presentation"><path d="M8 1l7 14H1L8 1z" /></svg>
              <div class="representation">
                <code data-svgr-source>&lt;svg&gt;</code>
                <code data-svgr-result>&lt;Icon /&gt;</code>
              </div>
            </div>
            <div class="benchmark"><strong>29.99×</strong><span>JSX · tiny fixture</span></div>
          </div>
        </div>
      </div>

      <div class="triggers" aria-hidden="true">
        {scenes.map((scene) => <div class:list={["trigger", { identity: scene === "identity" }]} data-trigger={scene}><span>{scene}</span></div>)}
      </div>
    </section>

    <section class="writing-frame">
      <header><h2>Writing</h2><span>Quiet epilogue</span></header>
      <ol>
        {posts.map((post) => (
          <li><time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time><strong>{post.data.title}</strong></li>
        ))}
      </ol>
    </section>
  </main>
</LabLayout>

<script>
  import { annotate, annotationGroup } from "@rougher-stuff/rough-notation";
  import type { RoughAnnotation, RoughAnnotationGroup } from "@rougher-stuff/rough-notation";
  import { createEffect } from "@tradimation/core";
  import type { EffectController } from "@tradimation/core";

  type SceneKey = "identity" | "rougher-stuff" | "trandimation" | "svgr2";

  const root = document.querySelector<HTMLElement>("[data-recomposition]");
  const stage = root?.querySelector<HTMLElement>("[data-stage]");
  const titles = new Map(
    [...(root?.querySelectorAll<HTMLElement>("[data-title]") ?? [])].map((title) => [title.dataset.title as SceneKey, title]),
  );
  const proofs = new Map(
    [...(root?.querySelectorAll<HTMLElement>("[data-proof]") ?? [])].map((proof) => [proof.dataset.proof as SceneKey, proof]),
  );
  const triggers = [...(root?.querySelectorAll<HTMLElement>("[data-trigger]") ?? [])];
  const intro = root?.querySelector<HTMLElement>("[data-intro]");
  const chapterNumber = root?.querySelector<HTMLElement>("[data-chapter-number]");
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const projectOrder: SceneKey[] = ["rougher-stuff", "trandimation", "svgr2"];
  const played = new Set<SceneKey>();
  const annotations: RoughAnnotation[] = [];

  let roughGroup: RoughAnnotationGroup | undefined;
  let titleController: EffectController | undefined;
  let proofController: EffectController | undefined;
  let currentScene: SceneKey = "identity";
  let requestedScene: SceneKey = "identity";
  let transitioning = false;

  const applyTitle = (scene: SceneKey) => {
    titles.forEach((title, key) => {
      const active = key === scene;
      title.style.visibility = active ? "visible" : "hidden";
      title.style.transform = "scale(1)";
      title.setAttribute("aria-hidden", String(!active));
      title.inert = !active;
    });
  };

  const showOnlyProof = (scene: SceneKey) => {
    proofs.forEach((proof, key) => {
      const active = key === scene;
      proof.classList.toggle("active", active);
      proof.setAttribute("aria-hidden", String(!active));
    });
  };

  const measureMotion = () => {
    const proof = proofs.get("trandimation");
    const field = proof?.querySelector<HTMLElement>("[data-motion-field]");
    const specimen = proof?.querySelector<HTMLElement>("[data-motion-specimen]");
    const registration = proof?.querySelector<SVGElement>("[data-motion-registration]");
    if (!field || !specimen || !registration) return 0;
    const origin = field.clientWidth * (window.innerWidth <= 700 ? .09 : .14);
    const desired = window.innerWidth <= 700 ? 110 : 220;
    const distance = Math.max(72, Math.min(desired, field.clientWidth - origin - specimen.offsetWidth - 28));
    registration.style.left = `${origin + specimen.offsetWidth / 2 + distance}px`;
    return distance;
  };

  const settleProof = (scene: SceneKey) => {
    if (scene === "rougher-stuff") roughGroup?.show({ duration: 0 });
    if (scene === "trandimation") {
      const proof = proofs.get(scene);
      const specimen = proof?.querySelector<HTMLElement>("[data-motion-specimen]");
      const registration = proof?.querySelector<SVGElement>("[data-motion-registration]");
      const distance = measureMotion();
      if (specimen) specimen.style.transform = `translateX(${distance}px)`;
      registration?.classList.add("settled");
    }
    if (scene === "svgr2") {
      const proof = proofs.get(scene);
      const source = proof?.querySelector<HTMLElement>("[data-svgr-source]");
      const result = proof?.querySelector<HTMLElement>("[data-svgr-result]");
      if (source) {
        source.style.visibility = "hidden";
        source.style.transform = "scale(1)";
      }
      if (result) {
        result.style.visibility = "visible";
        result.style.transform = "scale(1)";
      }
    }
  };

  const leaveScene = (scene: SceneKey) => {
    proofController?.destroy();
    proofController = undefined;
    if (scene !== "identity") {
      settleProof(scene);
      played.add(scene);
    }
    if (scene === "rougher-stuff") roughGroup?.hide();
  };

  const enterScene = (scene: SceneKey) => {
    if (scene === "identity") return;
    if (played.has(scene) || reducedMotion) {
      settleProof(scene);
      played.add(scene);
      return;
    }

    if (scene === "rougher-stuff") {
      roughGroup?.show({ duration: 1120 });
      played.add(scene);
      return;
    }

    if (scene === "trandimation") {
      const proof = proofs.get(scene);
      const field = proof?.querySelector<HTMLElement>("[data-motion-field]");
      const specimen = proof?.querySelector<HTMLElement>("[data-motion-specimen]");
      const distance = measureMotion();
      if (!field || !specimen) return;
      specimen.style.transform = "translateX(0)";
      try {
        const controller = createEffect(specimen, "smear", { overlayRoot: field, distance, duration: 670, cleanup: "commit" });
        proofController = controller;
        void controller.play().then(() => {
          settleProof(scene);
          played.add(scene);
          if (proofController === controller) proofController = undefined;
        });
      } catch {
        settleProof(scene);
        played.add(scene);
      }
      return;
    }

    const proof = proofs.get("svgr2");
    const source = proof?.querySelector<HTMLElement>("[data-svgr-source]");
    const result = proof?.querySelector<HTMLElement>("[data-svgr-result]");
    if (!source || !result) return;
    try {
      const controller = createEffect(source, "compress-swap", { secondary: result, duration: 780 });
      proofController = controller;
      void controller.play().then(() => {
        settleProof(scene);
        played.add(scene);
        if (proofController === controller) proofController = undefined;
      });
    } catch {
      settleProof(scene);
      played.add(scene);
    }
  };

  const setStageMode = (scene: SceneKey) => {
    const identity = scene === "identity";
    stage?.classList.toggle("work-mode", !identity);
    intro?.classList.toggle("hidden", !identity);
    chapterNumber?.setAttribute("aria-hidden", String(identity));
    if (!identity && chapterNumber) {
      const index = projectOrder.indexOf(scene) + 1;
      chapterNumber.textContent = `${String(index).padStart(2, "0")} / 03`;
    }
  };

  const transitionTo = async (scene: SceneKey) => {
    requestedScene = scene;
    if (transitioning) {
      titleController?.destroy();
      proofController?.destroy();
      return;
    }
    transitioning = true;

    while (currentScene !== requestedScene) {
      const destination = requestedScene;
      const sourceTitle = titles.get(currentScene);
      const destinationTitle = titles.get(destination);
      leaveScene(currentScene);
      showOnlyProof("identity");
      setStageMode(destination);

      const identityBoundary = (currentScene === "identity" && destination === "rougher-stuff")
        || (currentScene === "rougher-stuff" && destination === "identity");

      if (!reducedMotion && identityBoundary && sourceTitle && destinationTitle) {
        applyTitle(currentScene);
        titleController = createEffect(sourceTitle, "compress-swap", { secondary: destinationTitle, duration: 780 });
        await titleController.play();
        titleController = undefined;
      }

      currentScene = destination;
      applyTitle(currentScene);
      if (currentScene === requestedScene) {
        showOnlyProof(currentScene);
        enterScene(currentScene);
      }
    }

    transitioning = false;
  };

  const setup = async () => {
    if (!root || !stage) return;
    await document.fonts.ready;
    await new Promise<void>((resolve) => requestAnimationFrame(() => resolve()));
    const accent = getComputedStyle(document.documentElement).getPropertyValue("--color-accent").trim();
    const rougher = proofs.get("rougher-stuff");
    const underline = rougher?.querySelector<HTMLElement>("[data-notation='underline']");
    const circle = rougher?.querySelector<HTMLElement>("[data-notation='circle']");
    const bracket = rougher?.querySelector<HTMLElement>("[data-notation='bracket']");
    if (underline && circle && bracket) {
      annotations.push(
        annotate(underline, { type: "underline", color: accent, strokeWidth: 2, iterations: 1, roughness: 1.25, seed: 43, padding: [0, 2, 8, 2], animationDuration: 420 }),
        annotate(circle, { type: "circle", color: accent, strokeWidth: 2, iterations: 1, roughness: 1.25, seed: 43, padding: 12, animationDuration: 520 }),
        annotate(bracket, { type: "bracket", brackets: ["right"], color: accent, strokeWidth: 2, iterations: 1, roughness: 1.25, seed: 43, padding: 12, animationDuration: 420 }),
      );
      roughGroup = annotationGroup(annotations);
    }

    applyTitle("identity");
    showOnlyProof("identity");
    setStageMode("identity");

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        const scene = (entry.target as HTMLElement).dataset.trigger as SceneKey | undefined;
        if (scene) void transitionTo(scene);
      });
    }, { rootMargin: "-48% 0px -48% 0px" });

    triggers.forEach((trigger) => observer.observe(trigger));
    window.addEventListener("resize", () => {
      if (played.has("trandimation")) settleProof("trandimation");
    }, { passive: true });
    window.addEventListener("pagehide", () => {
      observer.disconnect();
      titleController?.destroy();
      proofController?.destroy();
      annotations.forEach((annotation) => annotation.remove());
    }, { once: true });
  };

  void setup();
</script>

<style>
  .recomposition { background: var(--color-bg); }
  .sequence { position: relative; display: grid; }
  .stage, .triggers { grid-area: 1 / 1; }
  .stage { --stage-bg: var(--color-bg); --stage-ink: var(--color-text); position: sticky; z-index: 1; top: 0; height: 100svh; overflow: hidden; color: var(--stage-ink); background: var(--stage-bg); transition: color 220ms ease, background-color 220ms ease; }
  .stage.work-mode { --stage-bg: #1d1c1a; --stage-ink: #f4f1ea; }
  .title-stack { position: absolute; z-index: 3; top: clamp(6rem, 10vh, 8rem); right: clamp(1.25rem, 4vw, 4rem); left: clamp(1.25rem, 4vw, 4rem); height: clamp(5rem, 14vw, 13rem); }
  .title-stack h1, .title-stack h2 { position: absolute; margin: 0; color: currentColor; font-size: clamp(5rem, 12vw, 12rem); font-weight: 500; letter-spacing: -.085em; line-height: .76; transform-origin: left center; white-space: nowrap; }
  .title-stack h2 { visibility: hidden; }
  [data-title="rougher-stuff"] { font-size: clamp(4rem, 10.5vw, 10.5rem) !important; }
  [data-title="trandimation"] { font-size: clamp(4rem, 11vw, 11rem) !important; }
  .intro { position: absolute; z-index: 3; right: clamp(1.25rem, 5vw, 6rem); bottom: clamp(3rem, 9vh, 7rem); margin: 0; font-size: clamp(1.8rem, 3.6vw, 3.8rem); font-weight: 500; letter-spacing: -.05em; line-height: 1.08; transition: opacity 150ms ease; }
  .intro.hidden { opacity: 0; }
  .chapter-number { position: absolute; z-index: 3; top: clamp(2rem, 4vh, 3rem); right: clamp(1.25rem, 4vw, 4rem); color: color-mix(in srgb, currentColor 52%, transparent); font: .68rem var(--font-mono); }
  .chapter-number[aria-hidden="true"] { visibility: hidden; }
  .proof-stack { position: absolute; z-index: 2; inset: 28vh 2vw 4vh; display: grid; place-items: center; }
  .proof { position: absolute; visibility: hidden; opacity: 0; }
  .proof.active { visibility: visible; opacity: 1; }
  .rougher-proof { display: grid; grid-template-columns: repeat(12, 1fr); grid-template-rows: repeat(3, 1fr); align-items: center; width: min(78vw, 66rem); height: min(52vh, 31rem); }
  .rougher-proof span { width: fit-content; font-size: clamp(2.5rem, 5.6vw, 5.8rem); font-weight: 500; letter-spacing: -.055em; line-height: .9; }
  [data-notation="underline"] { grid-column: 1 / 7; grid-row: 1; }
  [data-notation="circle"] { grid-column: 7 / 13; grid-row: 2; justify-self: end; }
  [data-notation="bracket"] { grid-column: 3 / 10; grid-row: 3; }
  .tradimation-proof { width: min(76vw, 66rem); }
  .motion-field { position: relative; aspect-ratio: 2.2 / 1; overflow: hidden; background-image: linear-gradient(color-mix(in srgb, var(--stage-ink) 7%, transparent) 1px, transparent 1px), linear-gradient(90deg, color-mix(in srgb, var(--stage-ink) 7%, transparent) 1px, transparent 1px); background-size: 24px 24px; }
  .specimen-origin { position: absolute; top: 50%; left: 14%; transform: translateY(-50%); }
  .specimen { display: grid; width: 190px; height: 74px; border: 2px solid var(--stage-ink); border-radius: 10px; color: var(--stage-bg); background: var(--color-accent); box-shadow: 6px 6px 0 var(--stage-ink); font-size: 1.08rem; font-weight: 600; letter-spacing: -.035em; place-items: center; }
  .registration { position: absolute; top: 50%; width: 32px; height: 32px; color: var(--color-accent); opacity: .45; transform: translate(-50%, -50%); }
  .registration path, .registration circle { fill: none; stroke: currentColor; stroke-width: 1; vector-effect: non-scaling-stroke; }
  .registration.settled { opacity: .85; }
  .svgr2-proof { position: relative; display: grid; width: min(76vw, 64rem); min-height: min(50vh, 30rem); place-items: center; }
  .fixture { display: grid; gap: 1.8rem; place-items: center; }
  .fixture svg { width: clamp(8rem, 18vw, 15rem); overflow: visible; }
  .fixture path { fill: none; stroke: var(--stage-ink); stroke-width: .7; vector-effect: non-scaling-stroke; }
  .representation { position: relative; display: grid; min-width: 9rem; height: 2.5rem; place-items: center; }
  .representation code { position: absolute; color: var(--stage-ink); font: 500 clamp(1.2rem, 2vw, 1.7rem) var(--font-mono); transform-origin: left center; white-space: nowrap; }
  [data-svgr-result] { visibility: hidden; }
  .benchmark { position: absolute; right: 0; bottom: 0; display: grid; justify-items: end; }
  .benchmark strong { color: var(--color-accent); font-size: clamp(2.2rem, 5vw, 4.5rem); font-weight: 500; letter-spacing: -.055em; line-height: .9; }
  .benchmark span { margin-top: .5rem; color: color-mix(in srgb, var(--stage-ink) 52%, transparent); font: .68rem var(--font-mono); }
  .triggers { position: relative; z-index: 0; pointer-events: none; }
  .trigger { height: 92svh; }
  .trigger.identity { height: 110svh; }
  .trigger span { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  .writing-frame { width: min(calc(100% - 3rem), 1180px); margin: 0 auto; padding: clamp(10rem, 18vw, 16rem) 0 8rem; }
  .writing-frame header { display: flex; align-items: end; justify-content: space-between; margin-bottom: clamp(3rem, 7vw, 6rem); }
  .writing-frame h2 { margin: 0; font-size: clamp(4.5rem, 10vw, 9rem); font-weight: 500; letter-spacing: -.075em; line-height: .8; }
  .writing-frame header span { color: var(--color-text-sub); font: .68rem var(--font-mono); }
  .writing-frame ol { margin: 0; padding: 0; border-top: 1px solid var(--color-border); list-style: none; }
  .writing-frame li { display: grid; grid-template-columns: 5rem 1fr; align-items: center; min-height: clamp(5rem, 9vw, 7.5rem); border-bottom: 1px solid var(--color-border); }
  .writing-frame time { color: var(--color-text-sub); font: .68rem var(--font-mono); }
  .writing-frame strong { font-size: clamp(1.15rem, 2.2vw, 1.75rem); font-weight: 500; letter-spacing: -.025em; line-height: 1.25; }
  @media (max-width: 700px) {
    .title-stack { top: 11vh; right: 1rem; left: 1rem; }
    .title-stack h1, .title-stack h2 { font-size: clamp(4.4rem, 19vw, 6.2rem); }
    .title-stack h2, [data-title="rougher-stuff"], [data-title="trandimation"] { font-size: min(15vw, 5.5rem) !important; }
    .intro { right: 1rem; bottom: 10vh; left: 1rem; font-size: clamp(1.55rem, 7vw, 2.4rem); }
    .chapter-number { top: 4vh; right: 1rem; }
    .proof-stack { inset: 27vh 0 5vh; }
    .rougher-proof { width: calc(100vw - 2rem); height: 46vh; }
    .rougher-proof span { font-size: clamp(2.6rem, 13vw, 4.5rem); }
    [data-notation="underline"] { grid-column: 1 / 11; }
    [data-notation="circle"] { grid-column: 4 / 13; }
    [data-notation="bracket"] { grid-column: 2 / 11; }
    .tradimation-proof, .svgr2-proof { width: calc(100vw - 2rem); }
    .motion-field { aspect-ratio: 1.25 / 1; }
    .specimen-origin { left: 9%; }
    .specimen { width: 150px; height: 60px; font-size: .92rem; }
    .svgr2-proof { min-height: 48vh; }
    .benchmark { right: .5rem; bottom: 1rem; }
    .trigger { height: 86svh; }
    .trigger.identity { height: 104svh; }
    .writing-frame { width: calc(100% - 2rem); padding-top: 9rem; }
    .writing-frame h2 { font-size: clamp(4rem, 20vw, 6rem); }
    .writing-frame header span { display: none; }
    .writing-frame li { grid-template-columns: 3.75rem 1fr; min-height: 5.5rem; }
    .writing-frame strong { font-size: 1.05rem; }
  }
  @media (prefers-reduced-motion: reduce) { .stage, .intro { transition: none; } }
</style>
