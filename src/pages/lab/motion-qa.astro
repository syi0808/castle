---
import LabLayout from "../../layouts/LabLayout.astro";

const swapFrames = [0, .24, .42, .43, .64, .82, 1];
---

<LabLayout title="Motion Frame Review">
  <main class="motion-qa">
    <header>
      <h1>Motion frame review</h1>
      <p>Authored effects at their meaningful frames.</p>
    </header>

    <section>
      <div class="frame-stage swap-stage">
        <strong class="identity-title" data-swap-source>Yein Sung</strong>
        <strong class="work-title" data-swap-destination>rougher-stuff</strong>
      </div>
      <div class="controls" data-swap-controls>
        {swapFrames.map((frame) => <button type="button" data-frame={frame}>{frame}</button>)}
      </div>
    </section>

    <section>
      <div class="frame-stage svgr-stage">
        <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 1l7 14H1L8 1z" /></svg>
        <div class="representation"><code data-svgr-source>&lt;svg&gt;</code><code data-svgr-destination>&lt;Icon /&gt;</code></div>
      </div>
      <div class="controls" data-svgr-controls>
        {swapFrames.map((frame) => <button type="button" data-frame={frame}>{frame}</button>)}
      </div>
    </section>
  </main>
</LabLayout>

<script>
  import { createEffect } from "@tradimation/core";

  const source = document.querySelector<HTMLElement>("[data-swap-source]");
  const destination = document.querySelector<HTMLElement>("[data-swap-destination]");
  const svgrSource = document.querySelector<HTMLElement>("[data-svgr-source]");
  const svgrDestination = document.querySelector<HTMLElement>("[data-svgr-destination]");

  const selectButton = (container: Element | null, selected: HTMLButtonElement) => {
    container?.querySelectorAll("button").forEach((button) => button.removeAttribute("aria-pressed"));
    selected.setAttribute("aria-pressed", "true");
  };

  const setup = async () => {
    await document.fonts.ready;
    if (!source || !destination || !svgrSource || !svgrDestination) return;

    const swap = createEffect(source, "compress-swap", { secondary: destination, duration: 780 });
    const svgrSwap = createEffect(svgrSource, "compress-swap", { secondary: svgrDestination, duration: 780 });

    document.querySelectorAll<HTMLButtonElement>("[data-swap-controls] button").forEach((button) => {
      button.addEventListener("click", () => {
        swap.seek(Number(button.dataset.frame));
        selectButton(button.parentElement, button);
      });
    });
    document.querySelectorAll<HTMLButtonElement>("[data-svgr-controls] button").forEach((button) => {
      button.addEventListener("click", () => {
        svgrSwap.seek(Number(button.dataset.frame));
        selectButton(button.parentElement, button);
      });
    });

    swap.seek(0);
    svgrSwap.seek(0);
    document.querySelector<HTMLButtonElement>("[data-swap-controls] button")?.setAttribute("aria-pressed", "true");
    document.querySelector<HTMLButtonElement>("[data-svgr-controls] button")?.setAttribute("aria-pressed", "true");
    window.addEventListener("pagehide", () => {
      swap.destroy();
      svgrSwap.destroy();
    }, { once: true });
  };

  void setup();
</script>

<style>
  .motion-qa { width: min(calc(100% - 3rem), 1180px); margin: 0 auto; padding: 15vh 0 8rem; }
  header { margin-bottom: 8rem; }
  h1 { margin: 0; font-size: clamp(3.5rem, 8vw, 7rem); font-weight: 500; letter-spacing: -.065em; line-height: .9; }
  header p { margin: 1.5rem 0 0; color: var(--color-text-sub); font-size: 1rem; }
  section { margin-top: 6rem; }
  .frame-stage { position: relative; display: grid; min-height: min(42vw, 28rem); overflow: hidden; border-top: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border); place-items: center; }
  .frame-stage strong { position: absolute; top: 32%; left: clamp(1rem, 4vw, 3rem); font-weight: 500; letter-spacing: -.085em; line-height: .76; transform-origin: left center; white-space: nowrap; }
  .identity-title { font-size: clamp(4rem, 11vw, 10rem); }
  .work-title { font-size: clamp(3.5rem, 9vw, 8rem); }
  [data-swap-destination] { visibility: hidden; }
  .svgr-stage { align-content: center; gap: 2rem; }
  .svgr-stage svg { width: clamp(7rem, 16vw, 12rem); }
  .svgr-stage path { fill: none; stroke: var(--color-text); stroke-width: .7; }
  .representation { display: grid; min-width: 9rem; height: 2.5rem; place-items: center; }
  .representation code { grid-area: 1 / 1; font: 500 clamp(1.2rem, 2vw, 1.7rem) var(--font-mono); transform-origin: left center; white-space: nowrap; }
  [data-svgr-destination] { visibility: hidden; }
  .controls { display: flex; gap: .4rem; flex-wrap: wrap; padding-top: 1rem; }
  button { min-width: 3.4rem; padding: .55rem .7rem; border: 1px solid var(--color-border); border-radius: 0; color: var(--color-text-sub); background: transparent; font: .75rem var(--font-mono); cursor: pointer; }
  button:hover, button:focus-visible, button[aria-pressed="true"] { border-color: var(--color-accent); color: var(--color-text); }

  @media (max-width: 700px) {
    .motion-qa { width: calc(100% - 2rem); }
    .frame-stage { min-height: 17rem; }
    .frame-stage strong { font-size: clamp(3rem, 15vw, 5rem); }
  }
</style>
