---
import LabLayout from "../../layouts/LabLayout.astro";
const prototypes = [
  { name: "Cinematic Landing", href: import.meta.env.BASE_URL, note: "The complete identity-to-work sequence." },
  { name: "Motion Frames", href: `${import.meta.env.BASE_URL}lab/motion-qa`, note: "Authored effects inspected across meaningful frames." },
];
---
<LabLayout title="Moving Draft — Prototypes">
  <main class="lab-index">
    <header><h1>Moving Draft</h1></header>
    <ol>{prototypes.map((prototype) => <li><a href={prototype.href}><strong>{prototype.name}</strong><p>{prototype.note}</p><b>↗</b></a></li>)}</ol>
  </main>
</LabLayout>
<style>
  .lab-index { width: min(calc(100% - 3rem), 1180px); margin: 0 auto; padding: 18vh 0 8rem; } header { margin-bottom: 12vh; } h1 { margin: 0; font-size: clamp(4.5rem, 11vw, 10rem); font-weight: 500; letter-spacing: -.075em; line-height: .88; } ol { margin: 0; padding: 0; border-top: 1px solid var(--color-border); list-style: none; } li { border-bottom: 1px solid var(--color-border); } li a { display: grid; grid-template-columns: 1fr minmax(15rem, 26rem) 1rem; align-items: center; min-height: 8rem; text-decoration: none; } strong { font-size: clamp(1.6rem, 3vw, 2.8rem); font-weight: 500; letter-spacing: -.04em; } p { margin: 0; color: var(--color-text-sub); font-size: .85rem; } b { color: var(--color-accent); font-weight: 400; } @media (max-width: 700px) { .lab-index { width: calc(100% - 2rem); } li a { grid-template-columns: 1fr 1rem; padding: 1.5rem 0; } p { display: none; } }
</style>
