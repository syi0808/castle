---
import BaseLayout from "../../layouts/BaseLayout.astro";
import JsonLd from "../../components/JsonLd.astro";
import { getSortedPosts, getAllTags } from "../../lib/posts";
import { SITE } from "../../lib/seo";

const posts = await getSortedPosts();
const tags = getAllTags(posts);

const collectionLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: `Tags — ${SITE.title}`,
  description: "Browse articles by topic.",
  url: `${SITE.url}/tags/`,
  inLanguage: SITE.lang,
};
---

<BaseLayout title="Tags — Yein Sung" description="Browse posts by topic.">
  <JsonLd data={collectionLd} />
  <div class="site-shell tags-page"><h1>Tags</h1><ul>{[...tags.keys()].map((tag) => <li><a class="rough-link" href={`${import.meta.env.BASE_URL}tags/${tag}`}>{tag}</a></li>)}</ul></div>
</BaseLayout>

<style>
  .tags-page { padding: clamp(4rem, 9vw, 8rem) 0 2rem; } h1 { margin: 0 0 5rem; font-size: clamp(4rem, 10vw, 9rem); font-weight: 600; letter-spacing: -.08em; line-height: .8; } ul { display: flex; flex-wrap: wrap; gap: 1.2rem 2.5rem; margin: 0; padding: 0; list-style: none; } a { font-size: clamp(1.15rem, 2.2vw, 1.7rem); font-weight: 500; text-decoration: none; }
</style>
