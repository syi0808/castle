---
import BaseLayout from "../../layouts/BaseLayout.astro";
import WritingIndex from "../../components/writing/WritingIndex.astro";
import { getSortedPosts, getAllTags } from "../../lib/posts";
export async function getStaticPaths() { const posts = await getSortedPosts(); return [...getAllTags(posts).keys()].map((tag) => ({ params: { tag }, props: { posts: posts.filter((post) => post.data.tags.includes(tag)) } })); }
const { tag } = Astro.params; const { posts } = Astro.props;
---
<BaseLayout title={`${tag} — Yein Sung`} description={`Writing tagged ${tag}.`}><div class="site-shell tag-page"><header><h1>{tag}</h1></header><WritingIndex posts={posts} heading="Writing" /></div></BaseLayout>
<style>.tag-page { padding: clamp(4rem, 10vw, 8rem) 0 2rem; } header { margin-bottom: 5rem; } h1 { margin: 0; font-size: clamp(3.5rem, 9vw, 7rem); font-weight: 600; letter-spacing: -.07em; line-height: .9; }</style>
