---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Not Found — Yein Sung" description="Page not found." noindex>
  <div class="mx-auto max-w-[740px] px-6 py-32">
    <h1 class="text-8xl font-semibold tracking-tight text-(--color-border) mb-8">404</h1>
    <a href={import.meta.env.BASE_URL} class="rough-link text-sm text-(--color-text-sub) hover:text-(--color-text) transition-colors no-underline">Home</a>
  </div>
</BaseLayout>
