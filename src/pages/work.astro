---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectVisual from "../components/work/ProjectVisual.astro";
import { projects } from "../data/projects";
const sortedProjects = [...projects].sort((a, b) => a.order - b.order);
const featured = sortedProjects.filter((project) => project.featured && project.visual);
const remaining = sortedProjects.filter((project) => !project.featured || !project.visual);
---

<BaseLayout title="Work — Yein Sung" description="Open-source tools and interaction experiments by Yein Sung.">
  <div class="site-shell work-page" data-work-catalog>
    <header class="page-head"><h1>Work</h1></header>
    <div class="catalog">
      <ol class="chapters">
        {featured.map((project, index) => (
          <li class="chapter" data-chapter={project.visual}>
            <a href={project.website ?? project.github} data-project={project.visual} target="_blank" rel="noopener noreferrer">
              <span class="number">{String(index + 1).padStart(2, "0")}</span>
              <span class="project-copy"><strong>{project.name}</strong><span class="tagline">{project.tagline}</span></span>
              <time>{project.year}</time><span class="external">↗</span>
            </a>
            <div class="mobile-visual"><ProjectVisual name={project.visual!} /></div>
          </li>
        ))}
      </ol>
      <aside class="stage" aria-live="polite">{featured.map((project, index) => <ProjectVisual name={project.visual!} active={index === 0} />)}</aside>
    </div>

    {remaining.length > 0 && (
      <ol class="compact-index">
        {remaining.map((project) => (
          <li><a href={project.website ?? project.github} target="_blank" rel="noopener noreferrer"><span class="number">{String(project.order).padStart(2, "0")}</span><span class="project-copy"><strong>{project.name}</strong><span class="tagline">{project.tagline}</span></span><time>{project.year}</time><span class="external">↗</span></a></li>
        ))}
      </ol>
    )}
  </div>
</BaseLayout>

<script>
  const catalog = document.querySelector<HTMLElement>("[data-work-catalog]");
  if (catalog) {
    const rows = [...catalog.querySelectorAll<HTMLElement>("[data-project]")];
    const chapters = [...catalog.querySelectorAll<HTMLElement>("[data-chapter]")];
    const visuals = [...catalog.querySelectorAll<HTMLElement>(".stage [data-visual]")];
    const activate = (name?: string) => {
      rows.forEach((row) => row.classList.toggle("active", row.dataset.project === name));
      visuals.forEach((visual) => {
        const isTarget = visual.dataset.visual === name;
        if (!isTarget && visual.classList.contains("active")) visual.classList.add("played");
        visual.classList.toggle("active", isTarget);
      });
    };
    rows.forEach((row) => {
      row.addEventListener("pointerenter", () => activate(row.dataset.project));
      row.addEventListener("focus", () => activate(row.dataset.project));
    });
    const observer = new IntersectionObserver((entries) => {
      const chapter = entries.find((entry) => entry.isIntersecting)?.target as HTMLElement | undefined;
      if (!chapter) return;
      activate(chapter.dataset.chapter);
      chapter.querySelector<HTMLElement>(".mobile-visual [data-visual]")?.classList.add("active");
    }, { rootMargin: "-44% 0px -44% 0px" });
    chapters.forEach((chapter) => observer.observe(chapter));
    activate(rows[0]?.dataset.project);
  }
</script>

<style>
  .work-page { padding: clamp(4rem, 9vw, 8rem) 0 3rem; }
  .page-head { margin-bottom: clamp(6rem, 12vw, 11rem); }
  h1 { margin: 0; font-size: clamp(5rem, 12vw, 11rem); font-weight: 600; letter-spacing: -.09em; line-height: .76; }
  .catalog { display: grid; grid-template-columns: minmax(22rem, .82fr) minmax(30rem, 1.18fr); align-items: start; border-top: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border); }
  ol { margin: 0; padding: 0; list-style: none; }
  .chapters { border-right: 1px solid var(--color-border); }
  .chapter { display: grid; min-height: 52svh; border-bottom: 1px solid var(--color-border); align-items: center; }
  .chapter:last-child { border-bottom: 0; }
  li > a { display: grid; grid-template-columns: 3rem minmax(10rem, 1fr) 4rem 1.2rem; align-items: center; padding-right: clamp(1rem, 4vw, 3rem); text-decoration: none; }
  .number, time { color: var(--color-text-sub); font-family: var(--font-mono); font-size: .67rem; }
  .project-copy { display: grid; gap: .8rem; width: fit-content; }
  strong { position: relative; width: fit-content; font-size: clamp(2.2rem, 4vw, 4.4rem); font-weight: 500; letter-spacing: -.06em; line-height: 1; }
  .tagline { color: var(--color-text-sub); font-size: .78rem; letter-spacing: -.01em; line-height: 1.3; }
  .chapter strong::after { position: absolute; right: 0; bottom: -.28em; left: 0; height: 6px; background: url("data:image/svg+xml,%3Csvg width='120' height='6' viewBox='0 0 120 6' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M1 4C18 0 31 6 48 3S76 5 91 3s18 2 28 0' fill='none' stroke='%23a04432' stroke-width='1.6'/%3E%3C/svg%3E") repeat-x / 120px 6px; content: ""; opacity: 0; transform: scaleX(0); transform-origin: left; }
  .chapter a.active .number { color: var(--color-accent); }
  .chapter a.active strong::after { opacity: 1; transform: scaleX(1); transition: opacity 100ms, transform 360ms var(--ease-out-back); }
  .external { color: var(--color-accent); opacity: 0; transition: opacity 150ms; }
  li a:hover .external, li a:focus-visible .external { opacity: 1; }
  .stage { position: sticky; top: 12vh; overflow: hidden; height: 76vh; min-height: 35rem; pointer-events: none; }
  .mobile-visual { display: none; }
  .compact-index { margin-top: clamp(6rem, 12vw, 10rem); border-top: 1px solid var(--color-border); }
  .compact-index li { border-bottom: 1px solid var(--color-border); }
  .compact-index li > a { min-height: 6rem; }
  .compact-index strong { font-size: clamp(1.5rem, 2.6vw, 2.4rem); }

  @media (max-width: 850px) {
    .work-page { padding-top: 3rem; }
    .page-head { margin-bottom: 5rem; }
    .catalog { display: block; }
    .chapters { border-right: 0; }
    .chapter { display: block; min-height: 0; padding: 2rem 0 1rem; }
    li > a { grid-template-columns: 2.7rem 1fr auto; min-height: 4rem; padding-right: 0; }
    .chapter strong { font-size: clamp(2rem, 9vw, 3.3rem); }
    .project-copy { gap: .55rem; }
    .tagline { font-size: .72rem; }
    time { display: none; }
    .stage { display: none; }
    .mobile-visual { display: block; min-height: 14rem; }
    .compact-index { margin-top: 6rem; }
    .compact-index li > a { grid-template-columns: 2.7rem 1fr auto; }
  }
</style>
