---
import BaseLayout from "../layouts/BaseLayout.astro";
import { projects } from "../data/projects";

const sortedProjects = [...projects].sort((first, second) => first.order - second.order);
const projectsByYear = new Map<number, typeof projects>();

for (const project of sortedProjects) {
  if (!projectsByYear.has(project.year)) projectsByYear.set(project.year, []);
  projectsByYear.get(project.year)!.push(project);
}
---

<BaseLayout title="Projects — Yein Sung" description="Open-source tools and interaction experiments by Yein Sung.">
  <div class="site-shell work-page">
    <header class="page-head">
      <h1>Projects</h1>
      <p>A collection of open-source projects: useful, playful, and sometimes delightfully small.</p>
    </header>

    <div class="work-index">
      {[...projectsByYear.entries()].map(([year, yearProjects]) => (
        <section class="year-group">
          <h2>{year}</h2>
          <ol>
            {yearProjects.map((project) => (
              <li>
                <a href={project.website ?? project.github} target="_blank" rel="noopener noreferrer">
                  <span class="project">
                    <strong data-project-title>{project.name}</strong>
                    <span>{project.tagline}</span>
                  </span>
                  <span class="arrow">↗</span>
                </a>
              </li>
            ))}
          </ol>
        </section>
      ))}
    </div>
  </div>
</BaseLayout>

<script>
  import { annotate } from "@rougher-stuff/rough-notation";
  import type { RoughAnnotation } from "@rougher-stuff/rough-notation";

  const projectIndex = document.querySelector<HTMLElement>(".work-index");
  const annotations: RoughAnnotation[] = [];

  const setup = async () => {
    if (!projectIndex) return;
    await document.fonts.ready;
    const accent = getComputedStyle(document.documentElement).getPropertyValue("--color-accent").trim();
    projectIndex.querySelectorAll<HTMLElement>("[data-project-title]").forEach((title, index) => {
      const annotation = annotate(title, { type: "underline", color: accent, strokeWidth: 1.5, iterations: 1, roughness: 1.2, seed: 110 + index, padding: [0, 0, 4, 0], animationDuration: 260 });
      annotations.push(annotation);
      const link = title.closest<HTMLAnchorElement>("a");
      link?.addEventListener("pointerenter", () => annotation.show({ duration: 260 }));
      link?.addEventListener("pointerleave", () => annotation.hide());
      link?.addEventListener("focus", () => annotation.show({ duration: 260 }));
      link?.addEventListener("blur", () => annotation.hide());
    });
  };

  window.addEventListener("pagehide", () => annotations.forEach((annotation) => annotation.remove()), { once: true });
  void setup();
</script>

<style>
  .work-page { padding: clamp(4rem, 9vw, 8rem) 0 3rem; }
  .page-head { display: grid; grid-template-columns: minmax(0, 1fr) minmax(18rem, 28rem); align-items: end; gap: 3rem; margin-bottom: clamp(6rem, 12vw, 10rem); }
  h1 { margin: 0; font-size: clamp(4.5rem, 10vw, 8rem); font-weight: 500; letter-spacing: -.08em; line-height: .8; }
  .page-head p { margin: 0; color: var(--color-text-sub); font-size: .92rem; line-height: 1.7; }
  .year-group { display: grid; grid-template-columns: 9rem minmax(0, 1fr); margin-bottom: 5rem; }
  h2 { margin: 1.7rem 0 0; font: 500 .72rem var(--font-mono); }
  ol { margin: 0; padding: 0; border-top: 1px solid var(--color-border); list-style: none; }
  li { border-bottom: 1px solid var(--color-border); }
  li > a { display: grid; grid-template-columns: minmax(0, 1fr) 1.5rem; align-items: center; min-height: clamp(5.5rem, 8vw, 7rem); text-decoration: none; }
  .project { display: flex; align-items: baseline; gap: 1rem; min-width: 0; }
  strong { font-size: clamp(1.1rem, 2vw, 1.55rem); font-weight: 500; letter-spacing: -.025em; line-height: 1.2; }
  .project > span { overflow: hidden; color: var(--color-text-sub); font-size: .78rem; text-overflow: ellipsis; white-space: nowrap; }
  .arrow { justify-self: end; color: var(--color-accent); opacity: 0; transform: translate(-.25rem, .25rem); transition: opacity 140ms, transform 180ms; }
  li a:hover .arrow, li a:focus-visible .arrow { opacity: 1; transform: translate(0, 0); }

  @media (max-width: 700px) {
    .work-page { padding-top: 3rem; }
    .page-head { grid-template-columns: 1fr; gap: 2.5rem; margin-bottom: 6rem; }
    .page-head p { max-width: 28rem; }
    .year-group { grid-template-columns: 3.5rem minmax(0, 1fr); margin-bottom: 4rem; }
    h2 { margin-top: 1.8rem; }
    li > a { grid-template-columns: minmax(0, 1fr) 1rem; min-height: 6rem; }
    .project { display: grid; gap: .3rem; padding-right: .75rem; }
    strong { font-size: 1.08rem; }
    .project > span { font-size: .7rem; }
  }
</style>
